# Database connection URL for PostgreSQL
# This should match the database configuration in docker-compose.yaml
DATABASE_URL=postgresql://postgres:password@localhost:54321/electric

# Authentication secret - REQUIRED in production
# Generate a strong secret (minimum 32 characters)
BETTER_AUTH_SECRET=

# Electric Cloud Configuration (optional)
# Get these from https://dashboard.electric-sql.cloud/
# or use `npx @electric-sql/start` to provision automatically.
# If not set, it will try to connect to local Electric at `http://localhost:30000`
# and you can start it using `pnpm backend:up`
#
# ELECTRIC_URL=https://api.electric-sql.cloud
# ELECTRIC_SOURCE_ID=your-source-id
# ELECTRIC_SECRET=your-source-secret

# -----------------------------------------------------------------------------
# Conference-demo flags ("Local-First: Kill the Spinner"). ALL OFF BY DEFAULT.
# Exposed to the client bundle via `envPrefix: ['VITE_', 'DEMO_']` in
# vite.config.ts. See src/lib/demo-flags.ts. Requires a dev-server restart.
# -----------------------------------------------------------------------------

# S15: hold a FAILED write on screen before the optimistic row rolls back, so the
# audience can see it appear and then vanish. Never affects successful writes.
# DEMO_SLOW_ROLLBACK=true
# DEMO_ROLLBACK_DELAY_MS=2000

# S2: client-side latency added to the deliberately-slow /demo-before screen, so
# its spinner is perceptible on a local Postgres. Also switchable in the UI.
# DEMO_BEFORE_LATENCY_MS=400
