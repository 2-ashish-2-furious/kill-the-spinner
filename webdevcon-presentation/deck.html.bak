<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Local-First: Kill the Spinner — WebDevCon Berlin 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,500;0,600;0,700;1,600;1,700&family=Gaegu:wght@400;700&family=Kalam:wght@400;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --cream:#fbf7e0; --cream-2:#f6f1d4; --card:#fffdf3;
    --ink:#1c1c28; --burgundy:#6d1039; --mauve:#9a3b6b;
    --pen-purple:#7b3fbf; --pen-blue:#3f6bd6; --pen-slate:#5b6b8c;
    --danger:#c62d42; --green:#1f8a5b; --line:#23222c;
    --grad:linear-gradient(90deg,#26b7a6 0%,#2f6bd8 52%,#3a2fae 100%);
    --head:"Poppins",-apple-system,BlinkMacSystemFont,sans-serif;
    --hand:"Gaegu","Kalam",cursive;
    --body:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
    --shadow:5px 5px 0 rgba(35,34,44,.12);
    /* logical slide canvas — every slide is authored at exactly this size and then uniformly
       scaled to fit the frame, so windowed and fullscreen are the same picture, resized. */
    --sw:1168px; --sh:652px;
  }
  * { box-sizing:border-box; margin:0; padding:0; }
  html,body { height:100%; }
  body { background:#0d0d14; color:var(--ink); font-family:var(--body); overflow:hidden; -webkit-font-smoothing:antialiased; }

  #deck { height:100vh; width:100vw; display:grid; place-items:center; }
  .stage { width:min(1180px,94vw); aspect-ratio:16/9; max-height:94vh; position:relative;
           border-radius:14px; padding:6px; background:var(--grad); box-shadow:0 30px 80px -30px rgba(0,0,0,.7); }
  .frame { position:absolute; inset:6px; border-radius:9px; background:var(--cream); overflow:hidden; }
  /* the scaled layer: authored at --sw × --sh, translated + scaled by fitDeck() to fill the frame.
     Anything that should grow with the screen lives inside here. */
  .canvas { position:absolute; left:0; top:0; width:var(--sw); height:var(--sh);
            transform-origin:0 0; transform:translate(var(--sx,0px),var(--sy,0px)) scale(var(--sk,1)); }
  .slide { position:absolute; inset:0; background:var(--cream); display:none; flex-direction:column;
           padding:9% 5% 6%; opacity:0; transition:opacity .3s ease; }
  .slide.active { display:flex; opacity:1; }
  .slide.center-mid { justify-content:center; padding-top:5%; }

  .brand { position:absolute; top:3.4%; left:5%; right:5%; display:flex; align-items:center; justify-content:space-between; z-index:5; }
  .logo-l { font-family:var(--head); font-weight:700; font-size:clamp(.85rem,1.6vw,1.2rem); color:var(--ink); }
  .logo-l b { color:var(--burgundy); }
  .logo-r { font-family:var(--head); font-weight:600; font-size:clamp(.75rem,1.4vw,1rem); color:var(--ink); position:relative; }
  .logo-r::after { content:""; position:absolute; left:0; bottom:-6px; width:24px; height:3px; background:var(--ink); border-radius:2px; }

  h1 { font-family:var(--head); font-weight:700; color:var(--burgundy); font-size:clamp(1.8rem,4.6vw,3.4rem); line-height:1.02; letter-spacing:-.01em; }
  h2 { font-family:var(--head); font-weight:700; color:var(--burgundy); font-size:clamp(1.3rem,3.2vw,2.35rem); line-height:1.06; letter-spacing:-.01em; margin-bottom:.2em; }
  h2 .dim { color:var(--ink); }
  .hl { color:var(--mauve); font-weight:700; }
  .hl-b { color:var(--burgundy); font-weight:700; }
  .sub { font-family:var(--body); font-weight:400; color:var(--ink); font-size:clamp(1rem,2.1vw,1.55rem); margin-top:1.1rem; }
  .cap { font-family:var(--body); color:var(--pen-slate); font-size:clamp(.85rem,1.5vw,1.15rem); margin-top:1rem; max-width:70ch; line-height:1.45; }
  .bigline { font-family:var(--head); font-weight:700; color:var(--burgundy); font-size:clamp(1.3rem,3vw,2.2rem); line-height:1.12; margin-top:1rem; }
  .quote { font-family:var(--head); font-style:italic; font-weight:600; color:var(--mauve); font-size:clamp(1.6rem,4.2vw,3.1rem); line-height:1.16; max-width:24ch; }
  .quote b { color:var(--burgundy); font-weight:700; font-style:italic; }

  /* bullets */
  .bullets { margin-top:1.1rem; display:flex; flex-direction:column; gap:.8rem; }
  /* marker hangs in a left gutter rather than being a flex sibling — so inline <b>/<code> inside a
     bullet stays in normal inline flow instead of becoming its own gapped flex item */
  .bullets li { list-style:none; position:relative; padding-left:1.6em; font-size:clamp(1rem,1.9vw,1.4rem); line-height:1.35; }
  .bullets li::before { content:"→"; color:var(--mauve); font-weight:700; position:absolute; left:0; top:0; }

  /* card grids */
  .cards { display:grid; gap:clamp(.7rem,1.6vw,1.15rem); margin-top:auto; margin-bottom:auto; }
  .c2 { grid-template-columns:repeat(2,1fr); } .c3 { grid-template-columns:repeat(3,1fr); } .c4 { grid-template-columns:repeat(4,1fr); }
  .card { background:var(--card); border:2.5px solid var(--line); border-radius:16px; padding:1.1rem 1.2rem; box-shadow:var(--shadow); display:flex; flex-direction:column; gap:.45rem; }
  .card .cnum { font-family:var(--hand); font-weight:700; color:var(--mauve); font-size:1.7rem; line-height:1; }
  .card .cico { font-size:clamp(1.5rem,3vw,2.1rem); line-height:1; }
  /* drawn card icon (slide 9) — the hand-drawn counterpart to the emoji .cico */
  .card .chead { display:flex; align-items:center; justify-content:space-between; gap:.5rem; }
  .card .cart { flex:0 0 auto; width:clamp(50px,6.4vw,74px); height:auto; }
  .card .cart.w { width:clamp(80px,10.2vw,124px); }   /* wider variant: server→client transfer diagrams */
  .card .cx { font-family:var(--hand); font-weight:700; color:var(--pen-slate); font-size:clamp(.84rem,1.38vw,1.05rem); line-height:1.25; margin-top:.2rem; }
  .card .ct { font-family:var(--head); font-weight:700; color:var(--burgundy); font-size:clamp(.98rem,1.7vw,1.22rem); }
  .card .cd { font-size:clamp(.76rem,1.25vw,.96rem); color:var(--ink); line-height:1.4; }
  code { font-family:var(--mono); font-size:.9em; color:var(--burgundy); background:var(--cream-2); padding:.08em .32em; border-radius:4px; }
  .card.accent { border-top:6px solid; border-top-color:var(--mauve); }
  /* compact variant for 2x2 grids that also carry a cap + bigline */
  .cards.tight { gap:clamp(.55rem,1.1vw,.82rem); }
  .cards.tight .card { padding:.8rem .95rem; gap:.28rem; }
  .cards.tight .card .cart { width:clamp(42px,5.4vw,62px); }

  /* horizontal flow (boxes + arrows) */
  .flow { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; margin:auto 0; justify-content:center; }
  .fbox { background:var(--card); border:2.5px solid var(--line); border-radius:14px; padding:.9rem 1rem; text-align:center; box-shadow:var(--shadow); min-width:clamp(110px,14vw,160px); }
  .fbox .fi { font-size:clamp(1.4rem,2.8vw,2rem); } .fbox .fl { font-family:var(--head); font-weight:700; margin-top:.25rem; font-size:clamp(.85rem,1.4vw,1.1rem); }
  .fbox .fs { font-size:clamp(.68rem,1.1vw,.82rem); color:var(--pen-slate); margin-top:.1rem; }
  .fbox.bad { border-color:var(--danger); } .fbox.bad .fl,.fbox.bad .fi { color:var(--danger); }
  .fbox.good { border-color:var(--green); } .fbox.good .fl { color:var(--green); }
  .farrow { font-family:var(--hand); font-size:clamp(1.4rem,2.6vw,2rem); color:var(--pen-purple); font-weight:700; }
  .farrow .lab { display:block; font-size:.6em; color:var(--pen-slate); }

  /* code */
  pre.code { background:var(--card); border:2.5px solid var(--line); border-radius:14px; padding:1.3rem 1.5rem;
             font-family:var(--mono); font-size:clamp(.68rem,1.3vw,1rem); line-height:1.6; color:#2b2b3a; box-shadow:var(--shadow); overflow:auto; }
  pre.code .cm{color:#8a8a99;} pre.code .kw{color:var(--mauve);font-weight:700;} pre.code .fn{color:var(--pen-blue);}
  pre.code .str{color:var(--green);} pre.code .bad{color:var(--danger);font-weight:700;}
  .code-row { flex:1; display:flex; align-items:center; gap:3%; }
  .code-row pre.code { flex:1; }
  .code-cap { font-family:var(--head); font-weight:700; color:var(--burgundy); font-size:clamp(1rem,1.9vw,1.5rem); max-width:16ch; line-height:1.2; }
  .code-cap .strike { color:var(--danger); }
  /* slide 5 · spotlight code lines in place — visible from the start, highlighted on reveal.
     box-shadow (not padding) does the widening so the monospace grid never shifts. */
  .frag.hiline { opacity:1; transform:none; border-radius:4px; transition:background .3s ease, box-shadow .3s ease; }
  .frag.hiline.shown { background:#ffdbe2; box-shadow:0 0 0 .2em #ffdbe2; }
  /* green variant (slide 7) — the same spotlight, but on the line that replaced all of it */
  .frag.hiline.good.shown { background:#d6f0e1; box-shadow:0 0 0 .2em #d6f0e1; }
  /* slide 5 · "ceremony tax" tally beside the before-code */
  .tax { font-family:var(--body); font-weight:600; color:var(--ink); font-size:clamp(.8rem,1.35vw,1.05rem);
         line-height:1.25; margin-top:1em; display:flex; flex-direction:column; gap:.7em; }
  .tax > div { display:flex; align-items:baseline; gap:.12em; }
  .tax .tax-n { font-family:var(--hand); font-weight:700; font-size:2.7em; line-height:.72; color:var(--green); }
  .tax .net, .tax .net .tax-n { color:var(--danger); }
  .tax .ok { color:var(--green); }
  .taxnote { font-family:var(--hand); font-weight:700; color:var(--pen-slate); font-size:clamp(.9rem,1.55vw,1.18rem); line-height:1.22; margin-top:.9em; }
  .punch { font-family:var(--hand); font-weight:700; color:var(--mauve); font-size:clamp(.95rem,1.68vw,1.28rem); line-height:1.24; margin-top:1em; }

  /* two-panel race */
  .race { display:grid; grid-template-columns:1fr 1fr; gap:clamp(1rem,2.4vw,1.8rem); margin:auto 0; }
  .panel { border:2.5px solid var(--line); border-radius:16px; overflow:hidden; box-shadow:var(--shadow); background:var(--card); }
  .panel .ph { padding:.65rem 1rem; font-family:var(--head); font-weight:700; border-bottom:2.5px solid var(--line); display:flex; justify-content:space-between; align-items:center; font-size:clamp(.85rem,1.5vw,1.1rem); }
  .panel.old { border-color:var(--danger); } .panel.old .ph { color:var(--danger); border-color:var(--danger); }
  .panel.new { border-color:var(--green); } .panel.new .ph { color:var(--green); border-color:var(--green); }
  .panel .ph .t { font-family:var(--body); font-size:.7em; font-weight:600; color:var(--pen-slate); }
  .panel .pb { padding:1rem; min-height:clamp(150px,20vw,220px); display:flex; flex-direction:column; gap:.4rem; align-items:center; justify-content:center; }
  .rrow { width:100%; height:22px; border-radius:6px; background:var(--cream-2); border:1.5px solid #d8d0a8; }
  .rrow.ok { border-color:var(--green); background:#e7f6ee; }
  .spin { width:34px; height:34px; border:4px solid #e2dcb8; border-top-color:var(--danger); border-radius:50%; animation:spin .8s linear infinite; }
  @keyframes spin { to { transform:rotate(360deg); } }
  .synced { font-family:var(--hand); font-weight:700; color:var(--green); font-size:1.1rem; }
  .panel .pl { font-size:clamp(.82rem,1.42vw,1.06rem); line-height:1.38; }
  .panel .pdiag { align-self:center; flex:0 0 auto; width:clamp(148px,19vw,242px); height:auto; margin-bottom:.15rem; }
  .panel .picon { align-self:center; flex:0 0 auto; width:clamp(74px,8.6vw,104px); height:auto; margin-bottom:.1rem; }
  /* slide 11 · engine names as pills; the attributes live in the next slide's table */
  /* slide 11 · bottom row: who had to build it (left) vs what you install (right) */
  .logorow { display:grid; grid-template-columns:1fr 1.34fr; gap:clamp(.8rem,2.2vw,1.9rem); margin-top:.7rem; align-items:start; }
  .logogroup { display:flex; flex-direction:column; gap:.45rem; }
  .logogroup .lg-t { font-family:var(--hand); font-weight:700; font-size:clamp(.84rem,1.42vw,1.06rem); }
  .logogroup.built .lg-t { color:var(--danger); }
  .logogroup.shelf .lg-t { color:var(--green); }
  .logos { display:flex; flex-wrap:wrap; align-items:center; gap:.45rem clamp(.8rem,1.8vw,1.5rem); }
  .brandmark { display:inline-flex; align-items:center; gap:.45rem; font-family:var(--head); font-weight:700;
               font-size:clamp(.82rem,1.5vw,1.12rem); color:var(--ink); }
  .brandmark svg { flex:0 0 auto; width:clamp(15px,1.85vw,23px); height:auto; }
  .enginestrip { display:flex; flex-wrap:wrap; justify-content:center; align-items:center; gap:.5rem .8rem; margin-top:1.1rem;
                 font-family:var(--head); font-weight:700; font-size:clamp(.78rem,1.45vw,1.08rem); }
  .enginestrip span { background:var(--card); border:2.5px solid var(--line); border-radius:999px;
                      padding:.28rem .85rem; color:var(--burgundy); box-shadow:3px 3px 0 rgba(35,34,44,.1); }
  .enginestrip.compact { gap:.34rem .5rem; font-size:clamp(.7rem,1.22vw,.92rem); }
  .enginestrip.compact span { padding:.22rem .6rem; border-width:2px; }
  .enginestrip .more { border-style:dashed; border-color:#c3bb96; color:var(--pen-slate); font-weight:600; box-shadow:none; }

  /* video placeholder */
  .video { flex:1; display:flex; gap:3%; margin:auto 0; align-items:center; }
  /* demo screen: hand-drawn window chrome (reuses .mock-titlebar) wrapping the video stage */
  .screen { flex:1.6; aspect-ratio:16/10; background:var(--card); border:3px solid var(--line); border-radius:14px;
            box-shadow:var(--shadow); display:flex; flex-direction:column; overflow:hidden; }
  .scr-stage { flex:1; background:#101018; position:relative; display:grid; place-items:center; }
  .scr-stage video { width:100%; height:100%; object-fit:cover; display:block; }
  .play-btn { width:clamp(56px,7.4vw,86px); height:auto; }
  .play-btn .pulse { animation:playPulse 2.4s ease-in-out infinite; transform-origin:45px 45px; }
  @keyframes playPulse { 0%,100% { opacity:.6; transform:scale(1); } 50% { opacity:1; transform:scale(1.07); } }
  .screen .tag { position:absolute; bottom:7%; left:0; right:0; padding:0 8%; text-align:center; line-height:1.3;
                 font-family:var(--hand); font-weight:700; color:#bfe3dd; font-size:clamp(.72rem,1.25vw,.98rem); }
  .beats { flex:1; display:flex; flex-direction:column; gap:.8rem; }
  .beat { display:flex; gap:.6rem; align-items:flex-start; font-size:clamp(.85rem,1.5vw,1.12rem); }
  .beat .bn { font-family:var(--hand); font-weight:700; color:var(--mauve); font-size:1.4rem; line-height:1; }

  /* click-to-reveal fragments */
  .frag { opacity:0; transform:translateY(10px) scale(.97); transition:opacity .35s ease, transform .35s ease; }
  .frag.shown { opacity:1; transform:none; }
  /* pain callouts (slide 4) */
  .callcol { flex:1; display:flex; flex-direction:column; gap:.75rem; justify-content:center; }
  .callout { display:flex; gap:.8rem; align-items:center; background:var(--card); border:2.5px solid var(--danger);
             border-radius:13px; padding:.75rem 1rem; box-shadow:var(--shadow); font-size:clamp(.9rem,1.55vw,1.2rem); line-height:1.3; }
  .mini-spin { width:22px; height:22px; border:3px solid #e6dfba; border-top-color:var(--danger); border-radius:50%; animation:spin .8s linear infinite; flex:0 0 auto; }
  .reveal-hint { font-family:var(--hand); font-weight:700; color:var(--pen-slate); font-size:clamp(.85rem,1.5vw,1.15rem); }
  .reveal-hint.shown-all { display:none; }
  /* mini-scene icon inside a callout */
  .scene { flex:0 0 auto; width:62px; height:54px; }
  /* diagonal meme overlay (final reveal on slide 4) — hand-drawn, no red bg */
  .meme-wrap { position:absolute; inset:0; z-index:30; display:grid; place-items:center; overflow:hidden; pointer-events:none; }
  .meme-stamp { font-family:var(--head); font-weight:700; font-size:clamp(1.5rem,4.4vw,3rem);
    color:var(--burgundy); letter-spacing:.01em; text-align:center;
    background:rgba(251,247,224,.92); border:4px solid var(--burgundy); border-radius:16px;
    padding:.5rem 1.4rem; transform:rotate(-12deg); filter:url(#rough);
    box-shadow:8px 8px 0 rgba(109,16,57,.16); }
  .meme-wrap.shown .meme-stamp { animation: memePop .45s cubic-bezier(.2,1.6,.4,1) both; }
  @keyframes memePop { 0%{transform:rotate(-12deg) scale(.3);} 100%{transform:rotate(-12deg) scale(1);} }
  .skull-rain { position:absolute; inset:0; }
  .skull-rain span { position:absolute; top:-12%; font-size:clamp(1.1rem,2.6vw,1.9rem); opacity:0;
    animation: skullFall 2.6s linear infinite; }
  @keyframes skullFall {
    0%{top:-12%; opacity:0; transform:rotate(0deg);}
    10%{opacity:.95;}
    100%{top:112%; opacity:.8; transform:rotate(340deg);}
  }

  /* self-playing mock app window (slide 4, left) */
  .mockwin { flex:1.15; background:#fffdf3; border:3px solid var(--line); border-radius:14px; box-shadow:var(--shadow);
             overflow:hidden; display:flex; flex-direction:column; position:relative; min-height:clamp(200px,30vw,340px); }
  .mock-titlebar { background:#efe8c8; border-bottom:2px solid var(--line); padding:.4rem .7rem; display:flex; align-items:center; gap:.4rem; }
  .mock-titlebar .dot { width:10px; height:10px; border-radius:50%; background:#d9cfa0; border:1.5px solid var(--line); }
  .mock-titlebar .mtitle { font-family:var(--hand); font-weight:700; color:var(--pen-slate); margin-left:.5rem; font-size:clamp(.72rem,1.3vw,1rem); }
  .mock-toolbar { display:flex; gap:.6rem; padding:.5rem .7rem; border-bottom:2px dashed #e0d7ac; }
  .mbtn { font-family:var(--head); font-weight:700; font-size:clamp(.68rem,1.2vw,.92rem); color:var(--burgundy);
          background:var(--cream); border:2px solid var(--line); border-radius:9px; padding:.3rem .7rem; transform-origin:center; }
  .mock-body { position:relative; flex:1; padding:.7rem; overflow:hidden; }
  .mock-rows { display:flex; flex-direction:column; gap:7px; }
  .mrow { height:16px; border-radius:5px; background:var(--cream-2); border:1.5px solid #e0d7ac; }
  .mrow:nth-child(even){ width:88%; } .mrow:nth-child(3n){ width:76%; }
  .mock-empty { position:absolute; inset:0; display:grid; place-items:center; font-family:var(--hand); font-weight:700;
                color:var(--pen-slate); opacity:0; gap:.3rem; }
  .mock-spinner { position:absolute; inset:0; display:grid; place-items:center; opacity:0; }
  .mock-cursor { position:absolute; width:24px; height:24px; left:6%; top:72%; z-index:6;
                 filter:drop-shadow(1px 2px 1px rgba(0,0,0,.25)); }
  /* click-driven window states (JS toggles classes on reveal) */
  .mock-cursor { transition:left .55s ease, top .55s ease, transform .15s ease; }
  .mbtn { transition:transform .15s ease, background .2s ease; }
  .mbtn.click { transform:scale(.88); background:#ffd9df; }
  .mock-spinner { transition:opacity .3s ease; }
  .mock-spinner.on { opacity:1; }
  .mock-rows { transition:opacity .35s ease; }
  .mockwin.empty .mock-rows { opacity:0; }
  .mock-empty { transition:opacity .35s ease; }
  .mockwin.empty .mock-empty { opacity:.9; }

  /* matrix */
  table.matrix { width:100%; border-collapse:collapse; margin:auto 0; font-size:clamp(.72rem,1.3vw,1rem); background:var(--card); box-shadow:var(--shadow); }
  table.matrix th, table.matrix td { border:2px solid var(--line); padding:.55rem .7rem; text-align:left; }
  table.matrix th { font-family:var(--head); color:var(--burgundy); background:#f2eac6; }
  table.matrix td:first-child { font-family:var(--head); font-weight:700; }

  /* spectrum: hand-drawn bar with three stations, labels aligned under the pins */
  .spectrum { margin:auto 0; }
  .specsvg { width:100%; height:auto; max-height:25vh; display:block; }
  .specrow { display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(.5rem,1.5vw,1.3rem); margin-top:.3rem; }
  .specstop { text-align:center; }
  .specstop .ss-t { font-family:var(--head); font-weight:700; font-size:clamp(.86rem,1.55vw,1.14rem); color:var(--green); line-height:1.2; }
  .specstop.mid .ss-t { color:#9a7616; }
  .specstop.hard .ss-t { color:var(--danger); }
  .specstop .ss-d { font-size:clamp(.73rem,1.18vw,.93rem); color:var(--ink); line-height:1.38; margin-top:.32rem; }
  .specstop .ss-ref { font-family:var(--hand); font-weight:700; color:var(--pen-slate); font-size:clamp(.76rem,1.26vw,.98rem); line-height:1.25; margin-top:.4rem; }

  /* diagrams */
  .diagram { flex:1; display:grid; place-items:center; min-height:0; }
  .diagram svg { width:100%; height:100%; max-height:60vh; }
  .hlabel { font-family:var(--hand); font-weight:700; }

  .pnum { position:absolute; bottom:3%; left:5%; font-family:var(--head); font-weight:600; font-size:clamp(.6rem,1.1vw,.82rem); color:#b9b18c; z-index:5; }
  .confidential { position:absolute; bottom:3%; right:5%; z-index:9; font-family:var(--body); font-weight:600;
    font-size:clamp(.6rem,1.05vw,.8rem); color:#b0554f; letter-spacing:.05em; opacity:.85; pointer-events:none; }

  /* title-specific */
  .title-wrap { margin-top:2%; }
  .title-art { flex:1; display:grid; place-items:center; width:100%; margin-top:1%; }
  .title-art svg { width:min(640px,74%); height:auto; max-height:44vh; }
  .presenters { position:absolute; right:5%; bottom:12%; text-align:right; font-family:var(--head); font-weight:600; color:var(--mauve); font-size:clamp(1rem,2vw,1.5rem); line-height:1.5; }
  /* closing slide art: one screen, made instant — bookends the title slide's lightning */
  .credit { font-family:var(--hand); font-weight:700; color:#b0a882; font-size:clamp(.74rem,1.2vw,.95rem); margin-top:1rem; max-width:52ch; line-height:1.3; }
  /* closing slide · the two of us, for real */
  .face { text-align:center; }
  .face img { display:block; width:clamp(58px,8.4vw,106px); aspect-ratio:1; border-radius:50%; object-fit:cover;
              border:3px solid var(--line); box-shadow:var(--shadow); filter:grayscale(1); }
  .face .fname { font-family:var(--hand); font-weight:700; color:var(--ink); margin-top:.3rem;
                 font-size:clamp(.82rem,1.5vw,1.14rem); white-space:nowrap; }
  .face.big img { width:clamp(92px,12.6vw,170px); }
  .face.big .fname { font-size:clamp(1rem,2vw,1.42rem); margin-top:.4rem; }
  .closeart { position:absolute; right:5%; top:21%; width:clamp(158px,21vw,272px); z-index:4; }
  .closeart svg { width:100%; height:auto; }
  .avatars { position:absolute; left:5%; bottom:6%; display:flex; gap:clamp(1.4rem,3.4vw,2.8rem); align-items:flex-end; }
  /* slide 2 · one band holding the faces and the note, so the middle isn't dead space */
  .whorow { display:flex; align-items:center; justify-content:flex-start; gap:clamp(1.4rem,3.6vw,3.2rem); margin:auto 0; }
  .whorow .avatars, .whorow .selfnote { position:static; right:auto; bottom:auto; top:auto; left:auto; }
  .whorow .avatars { gap:clamp(2.2rem,5.4vw,4.8rem); }
  /* fills the space right of the faces and centres itself in it */
  .whorow .selfnote { flex:1; align-items:center; text-align:center; }
  /* slide 2 · hand-drawn self note, echoes the killed spinner from the title slide */
  .selfnote { position:absolute; right:5%; top:27%; display:flex; flex-direction:column; align-items:flex-end;
              gap:clamp(.45rem,1.1vw,.8rem); text-align:right; z-index:5; }
  .selfnote svg { flex:0 0 auto; width:clamp(46px,5.6vw,70px); height:auto; }
  .selfnote .sn-t { font-family:var(--head); font-weight:700; color:var(--mauve); font-size:clamp(.95rem,1.95vw,1.42rem); line-height:1.24; }
  .selfnote .sn-s { font-family:var(--hand); font-weight:700; color:var(--pen-slate); font-size:clamp(.92rem,1.75vw,1.28rem); line-height:1.15; margin-top:.35rem; }

  .nav { position:fixed; bottom:14px; left:50%; transform:translateX(-50%); display:flex; gap:.5rem; z-index:50;
         flex-wrap:nowrap; white-space:nowrap; align-items:center; }
  .nav button { font-family:var(--head); font-weight:600; font-size:.8rem; border:none; cursor:pointer; background:rgba(255,255,255,.12); color:#fff; padding:.4rem .8rem; border-radius:8px; backdrop-filter:blur(6px); }
  .nav button:hover { background:rgba(255,255,255,.25); }
  .counter { color:#fff; font-family:var(--head); font-size:.8rem; align-self:center; opacity:.8; padding:0 .4rem; }

  /* ---- fullscreen presenting (F, or double-click the deck) ----
     the framed card becomes the whole display: no gradient border, no dark letterbox, no 16:9
     box — the slide takes the full viewport at whatever aspect the screen happens to be. */
  body.fs .stage { width:100vw; height:100vh; max-height:none; aspect-ratio:auto;
                   padding:0; border-radius:0; background:none; box-shadow:none; }
  body.fs .frame { inset:0; border-radius:0; }
  /* the controls now sit on cream, so they get their own compact dark pill in the bottom margin —
     dimmed so it reads as chrome, full strength the moment you reach for it */
  body.fs .nav { bottom:9px; gap:.3rem; padding:.26rem .4rem; border-radius:11px;
                 background:rgba(12,12,20,.62); backdrop-filter:blur(6px);
                 opacity:.45; transition:opacity .18s ease; }
  body.fs .nav:hover { opacity:1; }
  body.fs .nav button { padding:.26rem .55rem; font-size:.72rem; }
  body.fs .nav .counter { font-size:.72rem; padding:0 .25rem; }
  body.fs .nav .hint { display:none; }   /* the shortcut reminder is windowed-only */
  body.fs .confidential { opacity:.5; }

  /* presenter notes — press N (or load with ?notes=1) */
  #notes { position:fixed; left:2vw; right:2vw; bottom:50px; z-index:60; display:none;
           max-height:32vh; overflow:auto; padding:.75rem 1.05rem; border-radius:10px;
           background:rgba(12,12,20,.93); color:#f4ecd4; font-family:var(--body);
           font-size:clamp(.78rem,1.15vw,1rem); line-height:1.55;
           box-shadow:0 12px 40px -10px rgba(0,0,0,.85); }
  #notes.on { display:block; }
  #notes b { color:#ffd21a; font-family:var(--head); margin-right:.55rem; }
  #notes i { opacity:.55; }
  .nav .hint { color:#fff; font-family:var(--head); font-size:.72rem; align-self:center; opacity:.45; padding-left:.3rem; }

  /* ---- presenter view (own window: deck.html?presenter=1, or press P) ---- */
  #presenter { display:none; }
  body.presenter { overflow:auto; background:#14141c; }
  body.presenter #deck, body.presenter .nav, body.presenter #notes { display:none; }
  body.presenter #presenter { display:flex; flex-direction:column; gap:1rem; padding:1.4rem clamp(1rem,3vw,2.2rem);
    min-height:100vh; color:#f4ecd4; font-family:var(--body); }
  #presenter header { display:flex; align-items:center; gap:1rem; flex-wrap:wrap;
    border-bottom:2px solid #2e2e3c; padding-bottom:.9rem; }
  #presenter .ptime { font-family:var(--mono); font-weight:700; font-size:clamp(1.6rem,4vw,2.6rem);
    color:#ffd21a; cursor:pointer; user-select:none; line-height:1; }
  #presenter .ppos { font-family:var(--head); font-weight:600; font-size:clamp(.95rem,1.6vw,1.2rem); opacity:.75; }
  #presenter .ppos b { color:#fff; font-size:1.35em; }
  /* reveal progress: dots for this slide's fragments + how many clicks remain */
  #presenter .pdots { display:flex; gap:.4rem; align-items:center; }
  #presenter .pdots i { width:11px; height:11px; border-radius:50%; border:2px solid #4a4a5e; display:block; }
  #presenter .pdots i.on { background:#ffd21a; border-color:#ffd21a; }
  #presenter .pclicks { font-family:var(--head); font-weight:700; font-size:clamp(.78rem,1.35vw,1rem);
    padding:.32rem .8rem; border-radius:999px; border:2px solid #3b3b4d; background:#22222e; white-space:nowrap; }
  #presenter .pclicks.more { color:#ffd21a; border-color:#5a5232; }
  #presenter .pclicks.last { color:#7ee0a8; border-color:#2f5a42; }
  #presenter .pbtns { margin-left:auto; display:flex; gap:.5rem; }
  #notes .nfrag { color:#ffd21a; font-family:var(--head); font-weight:700; margin-right:.55rem; }
  #presenter .pbtns button { font-family:var(--head); font-weight:700; font-size:1rem; cursor:pointer;
    border:2px solid #3b3b4d; background:#22222e; color:#f4ecd4; padding:.55rem 1.1rem; border-radius:9px; }
  #presenter .pbtns button:hover { background:#2e2e3e; }
  #presenter section { border-radius:12px; padding:1rem 1.2rem; background:#1c1c26; border:2px solid #2e2e3c; }
  #presenter section.pnow { border-color:#4a4a2c; background:#1f1f22; }
  #presenter h3 { font-family:var(--head); font-weight:700; font-size:.82rem; letter-spacing:.09em;
    text-transform:uppercase; color:#8f8f7a; margin-bottom:.5rem; }
  #presenter .pnow p { font-size:clamp(1rem,1.9vw,1.42rem); line-height:1.55; }
  #presenter .pnext { opacity:.8; }
  #presenter .pnext .ptitle { font-family:var(--head); font-weight:700; color:#ffd21a;
    font-size:clamp(.95rem,1.7vw,1.2rem); margin-bottom:.35rem; }
  #presenter .pnext p { font-size:clamp(.82rem,1.4vw,1.02rem); line-height:1.5; }
  #presenter .pfoot { font-size:.82rem; opacity:.45; font-family:var(--head); }
</style>
</head>
<body>
<div id="deck">
  <div class="stage">
    <div class="frame">

      <!-- ========== 1 · TITLE ========== -->
      <section class="slide active">
        <!-- NOTES: Every app waits on the network. Click, wait, spinner. We'll show how to make the wait disappear: stop fetching on every read, sync a live copy instead. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <div class="title-wrap">
          <h1>Local-First:<br>Kill the Spinner</h1>
          <div class="sub">Sync, don't fetch. <span class="hl">Making applications feel instant.</span></div>
        </div>
        <div class="title-art">
          <svg viewBox="0 0 470 210" preserveAspectRatio="xMidYMid meet">
            <defs><marker id="ta" markerWidth="10" markerHeight="10" refX="7" refY="5" orient="auto"><path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--line)" stroke-width="2" stroke-linecap="round"/></marker></defs>
            <!-- spinner being killed -->
            <g transform="translate(92,95)">
              <g><animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="1.6s" repeatCount="indefinite"/>
                <g filter="url(#rough)"><path d="M0 -46 A46 46 0 1 1 -32 -33" fill="none" stroke="#a6a6a6" stroke-width="11" stroke-linecap="round"/></g>
              </g>
              <path d="M-52 -52 L52 52" stroke="var(--danger)" stroke-width="10" stroke-linecap="round"/>
            </g>
            <text x="92" y="188" class="hlabel" font-size="23" fill="var(--pen-slate)" text-anchor="middle">no more spinner</text>
            <!-- arrow -->
            <path d="M168 95 L250 95" fill="none" stroke="var(--line)" stroke-width="3.5" marker-end="url(#ta)"/>
            <!-- lightning = instant (larger, glowing, stronger pulse) -->
            <g transform="translate(320,96)">
              <g><animateTransform attributeName="transform" type="scale" values="1;1.14;1" dur="2.4s" repeatCount="indefinite"/>
                <g filter="url(#glow)"><g filter="url(#rough)"><path d="M18 -62 L-24 6 L6 6 L-15 65 L43 -15 L11 -15 Z" fill="#ffd21a" stroke="var(--line)" stroke-width="4.5" stroke-linejoin="round"/></g></g>
              </g>
              <g stroke="var(--mauve)" stroke-width="3.5" stroke-linecap="round"><path d="M52 -44 l12 -12 M56 -18 l14 -3 M50 10 l12 11"/></g>
            </g>
            <text x="350" y="184" class="hlabel" font-size="24" fill="var(--mauve)" text-anchor="middle">instant ⚡</text>
          </svg>
        </div>
        <div class="pnum">1</div>
      </section>

      <!-- ========== 2 · WHO WE ARE ========== -->
      <section class="slide">
        <!-- NOTES: <20s. We build data-heavy internal applications, felt the spinner pain, watched local-first fix it. No org charts. Straight into the problem. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>Who <span class="hl">we are</span></h2>
        <div class="sub" style="max-width:38ch;">That's genuinely all you need to know about us — this talk is about <span class="hl">killing spinners</span>, not org charts.</div>
        <div class="whorow">
        <div class="avatars">
          <div class="face big"><img src="ashish.jpg" alt="Ashish Singh"><div class="fname">Ashish</div></div>
          <div class="face big"><img src="shivam.png" alt="Shivam Negi"><div class="fname">Shivam</div></div>
        </div>
        <div class="selfnote">
          <svg viewBox="0 0 54 54">
            <g transform="translate(27,27)">
              <g><animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="1.6s" repeatCount="indefinite"/>
                <g filter="url(#rough)">
                  <path d="M0 -17 A17 17 0 1 1 -12 -12" fill="none" stroke="var(--pen-purple)" stroke-width="4.6" stroke-linecap="round"/>
                  <path d="M-5 -19 L-8 -8 L-17 -16 Z" fill="var(--pen-purple)"/>
                </g>
              </g>
            </g>
          </svg>
          <div>
            <div class="sn-t">Your friendly<br>neighbourhood engineers.</div>
            <div class="sn-s">≈ a decade of staring<br>at other people's spinners</div>
          </div>
        </div>
        </div>
        <div class="pnum">2</div>
      </section>

      <!-- ========== 3 · FETCH-AND-SPINNER LOOP ========== -->
      <section class="slide">
        <!-- NOTES: The loop almost every app runs on. Look where the network sits — in front of the user, on every read; every write triggers a refetch. We stopped seeing it as a choice. But it is one. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>The <span class="hl">fetch-and-spinner</span> loop</h2>
        <div class="diagram">
          <svg viewBox="0 0 960 430" preserveAspectRatio="xMidYMid meet">
            <defs>
              <marker id="a3" markerWidth="11" markerHeight="11" refX="7" refY="5" orient="auto"><path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--line)" stroke-width="2" stroke-linecap="round"/></marker>
              <marker id="a3p" markerWidth="11" markerHeight="11" refX="7" refY="5" orient="auto"><path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--pen-purple)" stroke-width="2" stroke-linecap="round"/></marker>
            </defs>

            <!-- connector arrows -->
            <path d="M205 175 L285 175" fill="none" stroke="var(--line)" stroke-width="2.6" marker-end="url(#a3)"/>
            <path d="M438 175 L518 175" fill="none" stroke="var(--line)" stroke-width="2.6" marker-end="url(#a3)"/>
            <path d="M671 175 L751 175" fill="none" stroke="var(--line)" stroke-width="2.6" marker-end="url(#a3)"/>
            <!-- loop-back arc (refetch → repeat) -->
            <path d="M830 252 C 922 300 900 352 720 360 C 470 374 300 374 150 358 C 112 352 114 300 132 256"
                  fill="none" stroke="var(--pen-purple)" stroke-width="2.4" stroke-dasharray="7 8" marker-end="url(#a3p)"/>
            <text x="480" y="392" class="hlabel" font-size="22" fill="var(--pen-purple)" text-anchor="middle">…and every interaction repeats</text>

            <!-- node cards (hand-drawn) -->
            <g filter="url(#rough)">
              <rect x="55"  y="110" width="150" height="130" rx="18" fill="var(--card)" stroke="var(--line)"   stroke-width="2.8"/>
              <rect x="288" y="110" width="150" height="130" rx="18" fill="#fffdf3" stroke="var(--danger)" stroke-width="2.8">
                <animate attributeName="fill" dur="6s" repeatCount="indefinite" calcMode="linear"
                  keyTimes="0;0.18;0.22;0.31;0.35;1" values="#fffdf3;#fffdf3;#ff9db0;#ff9db0;#fffdf3;#fffdf3"/>
                <animate attributeName="stroke-width" dur="6s" repeatCount="indefinite" calcMode="linear"
                  keyTimes="0;0.18;0.22;0.31;0.35;1" values="2.8;2.8;6.5;6.5;2.8;2.8"/>
              </rect>
              <rect x="521" y="110" width="150" height="130" rx="18" fill="#fffdf3" stroke="var(--danger)" stroke-width="2.8">
                <animate attributeName="fill" dur="6s" repeatCount="indefinite" calcMode="linear"
                  keyTimes="0;0.38;0.42;0.51;0.55;1" values="#fffdf3;#fffdf3;#ff9db0;#ff9db0;#fffdf3;#fffdf3"/>
                <animate attributeName="stroke-width" dur="6s" repeatCount="indefinite" calcMode="linear"
                  keyTimes="0;0.38;0.42;0.51;0.55;1" values="2.8;2.8;6.5;6.5;2.8;2.8"/>
              </rect>
              <rect x="755" y="110" width="150" height="130" rx="18" fill="var(--card)" stroke="var(--line)"   stroke-width="2.8"/>
            </g>

            <!-- ICON 1 · user tap (cursor + click ripples) -->
            <g filter="url(#rough)" transform="translate(130,175)">
              <g fill="none" stroke="var(--line)" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round">
                <path d="M-10 -18 L-10 16 L-2 8 L4 20 L9 17 L3 6 L12 6 Z" fill="#cfc9ee"/>
                <path d="M10 -20 Q18 -18 18 -10" opacity=".7"/>
                <path d="M-18 -22 Q-24 -16 -22 -8" opacity=".7"/>
              </g>
            </g>

            <!-- ICON 2 · fetch cloud (network) -->
            <g filter="url(#rough)" transform="translate(363,178)">
              <path d="M-42 14 q-26 -3 -27 -26 q3 -28 34 -26 q9 -26 42 -19 q26 -5 34 19 q26 0 22 28 q4 22 -22 23 z"
                    fill="#bfe3dd" stroke="var(--line)" stroke-width="2.8"/>
              <g fill="none" stroke="var(--line)" stroke-width="2.4" stroke-linecap="round">
                <path d="M-8 -2 L-8 -14 M-8 -14 L-13 -9 M-8 -14 L-3 -9"/>
                <path d="M10 -2 L10 10 M10 10 L5 5 M10 10 L15 5"/>
              </g>
            </g>

            <!-- ICON 3 · spinner (spins) -->
            <g transform="translate(596,175)">
              <g>
                <path d="M0 -22 A22 22 0 1 1 -15.5 -15.5" fill="none" stroke="var(--danger)" stroke-width="4.5" stroke-linecap="round"/>
                <path d="M-15.5 -15.5 l-8 -1 l4 8 z" fill="var(--danger)"/>
                <animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="0.9s" repeatCount="indefinite"/>
              </g>
            </g>

            <!-- ICON 4 · refetch (refresh arrows) -->
            <g filter="url(#rough)" transform="translate(830,175)">
              <g fill="none" stroke="var(--pen-purple)" stroke-width="4" stroke-linecap="round">
                <path d="M-18 -6 A20 20 0 0 1 16 -12"/>
                <path d="M16 -12 l-2 -11 M16 -12 l-11 3"/>
                <path d="M18 6 A20 20 0 0 1 -16 12"/>
                <path d="M-16 12 l2 11 M-16 12 l11 -3"/>
              </g>
            </g>

            <!-- labels -->
            <g class="hlabel" text-anchor="middle">
              <text x="130" y="272" font-size="26" fill="var(--ink)">User acts</text>
              <text x="363" y="272" font-size="26" fill="var(--danger)">Fetch</text>
              <text x="363" y="296" font-size="18" fill="var(--pen-slate)">network round-trip</text>
              <text x="596" y="272" font-size="26" fill="var(--danger)">Spinner</text>
              <text x="596" y="296" font-size="18" fill="var(--pen-slate)">the user waits</text>
              <text x="830" y="272" font-size="26" fill="var(--ink)">Refetch</text>
              <text x="830" y="296" font-size="18" fill="var(--pen-slate)">to stay fresh</text>
            </g>

            <!-- GLOWING ARROW · travels the journey, pausing at each node -->
            <g filter="url(#glow)">
              <path d="M-13 -10 L12 0 L-13 10 L-5 0 Z" fill="#7b3fbf" stroke="#ffffff" stroke-width="1.8" stroke-linejoin="round"/>
              <animateMotion dur="6s" repeatCount="indefinite" rotate="auto" calcMode="linear"
                keyPoints="0;0;0.14;0.14;0.28;0.28;0.42;0.42;1"
                keyTimes="0;0.12;0.20;0.32;0.40;0.52;0.60;0.72;1"
                path="M130 175 L363 175 L596 175 L830 175 C 922 226 900 352 720 360 C 470 374 300 374 150 358 C 108 352 110 240 130 178"/>
            </g>
          </svg>
        </div>
        <div class="cap">The <span class="hl-b">network sits in front of the user</span>. Every read is a wait; every write is a refetch.</div>
        <div class="pnum">3</div>
      </section>

      <!-- ========== 4 · THE BEFORE STORY / PAIN ========== -->
      <section class="slide">
        <!-- NOTES: Thousands of rows. Type a filter, spinner. Change a column, spinner. Edit a cell, refetch, spinner. Lose your place. "Did it save?" One flaky wifi moment and the screen is empty. Death by a thousand spinners. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>A day in the life of <span class="hl">a spinner</span></h2>
        <div class="video" style="align-items:stretch; gap:4%;">
          <div class="mockwin" id="mock4">
            <div class="mock-titlebar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="mtitle">Our Application — 12,480 rows</span></div>
            <div class="mock-toolbar">
              <div class="mbtn" id="mfilter">▾ Filter</div>
              <div class="mbtn" id="msearch">🔍 Search</div>
            </div>
            <div class="mock-body">
              <div class="mock-rows">
                <div class="mrow"></div><div class="mrow"></div><div class="mrow"></div>
                <div class="mrow"></div><div class="mrow"></div><div class="mrow"></div>
              </div>
              <div class="mock-empty">📡 offline — nothing to show</div>
              <div class="mock-spinner"><span class="spin"></span></div>
            </div>
            <svg class="mock-cursor" viewBox="0 0 24 24"><path d="M3 2 L3 20 L8 15 L11 22 L14 21 L11 14 L18 14 Z" fill="#fffdf3" stroke="var(--line)" stroke-width="1.6" stroke-linejoin="round"/></svg>
          </div>
          <div class="callcol">
            <!-- 1 · filter click → spinner -->
            <div class="callout frag" data-act="filter">
              <svg class="scene" viewBox="0 0 66 58">
                <g filter="url(#rough)"><path d="M8 12 H44 L30 30 V44 L22 39 V30 Z" fill="#cfe0f7" stroke="var(--line)" stroke-width="2.6" stroke-linejoin="round"/></g>
                <g transform="translate(30,26)"><path d="M0 0 L0 18 L5 13 L9 21 L12 19 L8 12 L14 12 Z" fill="#fffdf3" stroke="var(--line)" stroke-width="2" stroke-linejoin="round"/></g>
                <g transform="translate(52,16)"><g><path d="M0 -9 A9 9 0 1 1 -6.4 -6.4" fill="none" stroke="var(--danger)" stroke-width="3" stroke-linecap="round"/><path d="M-6.4 -6.4 l-3.6 -0.8 l1.8 3.6 z" fill="var(--danger)"/><animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="0.9s" repeatCount="indefinite"/></g></g>
              </svg>
              <div>Click a <b>filter</b> → spinner</div>
            </div>
            <!-- 2 · click search → refetch storm -->
            <div class="callout frag" data-act="search">
              <svg class="scene" viewBox="0 0 66 58">
                <g filter="url(#rough)"><rect x="10" y="22" width="30" height="16" rx="8" fill="#e2d3f3" stroke="var(--line)" stroke-width="2.4"/><circle cx="25" cy="30" r="6" fill="none" stroke="var(--line)" stroke-width="2.4"/><path d="M29 34 L35 40" stroke="var(--line)" stroke-width="2.6" stroke-linecap="round"/></g>
                <g fill="none" stroke="var(--danger)" stroke-width="2.6" stroke-linecap="round">
                  <path d="M46 10 A12 12 0 0 1 60 24"/><path d="M60 24 l0 -6 M60 24 l-6 0"/>
                  <path d="M58 34 A12 12 0 0 1 46 48"/><path d="M46 48 l0 6 M46 48 l6 0"/>
                </g>
              </svg>
              <div>Hit <b>search</b> → refetch storm</div>
            </div>
            <!-- 3 · edit cell → did it save? -->
            <div class="callout frag" data-act="edit">
              <svg class="scene" viewBox="0 0 66 58">
                <g filter="url(#rough)">
                  <rect x="10" y="12" width="34" height="34" rx="4" fill="#bfe3dd" stroke="var(--line)" stroke-width="2.6"/>
                  <rect x="18" y="12" width="18" height="10" fill="#fffdf3" stroke="var(--line)" stroke-width="2"/>
                  <rect x="16" y="30" width="22" height="16" rx="2" fill="#fffdf3" stroke="var(--line)" stroke-width="2"/>
                </g>
                <text x="50" y="30" font-family="Poppins" font-weight="700" font-size="26" fill="var(--danger)">?</text>
              </svg>
              <div>Edit a cell → <b>did it save?</b></div>
            </div>
            <!-- 4 · flaky wifi → empty screen -->
            <div class="callout frag" data-act="empty">
              <svg class="scene" viewBox="0 0 66 58">
                <g fill="none" stroke="var(--line)" stroke-width="2.6" stroke-linecap="round">
                  <path d="M6 22 A22 22 0 0 1 42 22"/><path d="M12 30 A14 14 0 0 1 36 30"/><path d="M18 38 A7 7 0 0 1 30 38"/>
                  <circle cx="24" cy="44" r="1.8" fill="var(--line)"/>
                </g>
                <path d="M8 12 L44 48" stroke="var(--danger)" stroke-width="3.6" stroke-linecap="round"/>
                <g filter="url(#rough)"><rect x="44" y="30" width="18" height="15" rx="2" fill="#fffdf3" stroke="var(--line)" stroke-width="2.2"/></g>
              </svg>
              <div>Flaky wifi → <b>empty screen</b></div>
            </div>
          </div>
        </div>
        <div class="cap">Every interaction pays the network tax. <span class="reveal-hint">(press → to live through the workday)</span></div>
        <div class="meme-wrap frag">
          <div class="skull-rain">
            <span style="left:6%;  animation-delay:0s;   animation-duration:2.4s">💀</span>
            <span style="left:16%; animation-delay:.5s;  animation-duration:2.9s">💀</span>
            <span style="left:27%; animation-delay:1.1s; animation-duration:2.2s">💀</span>
            <span style="left:38%; animation-delay:.2s;  animation-duration:2.7s">💀</span>
            <span style="left:49%; animation-delay:1.4s; animation-duration:2.5s">💀</span>
            <span style="left:60%; animation-delay:.8s;  animation-duration:3s">💀</span>
            <span style="left:71%; animation-delay:.3s;  animation-duration:2.3s">💀</span>
            <span style="left:82%; animation-delay:1.2s; animation-duration:2.8s">💀</span>
            <span style="left:92%; animation-delay:.6s;  animation-duration:2.6s">💀</span>
          </div>
          <div class="meme-stamp">💀&nbsp; DEATH BY A THOUSAND SPINNERS &nbsp;💀</div>
        </div>
        <div class="pnum">4</div>
      </section>

      <!-- ========== 5 · YOUR CODEBASE TODAY (before code) ========== -->
      <section class="slide">
        <!-- NOTES: Idiomatic React Query. Nothing wrong with it — it's what the docs teach. → the two branches light up. → count them: one line renders your UI, six negotiate with the network. → those six exist only because the data lives across the network. → and you won't even type it — the LLM will, because it trained on the same docs. Nobody decided this; we all inherited it. Hold that thought — slide 8 is this same component after. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>Your codebase, <span class="hl">today</span></h2>
        <div class="code-row">
<pre class="code"><span class="cm">// nobody chose this — it's just what the docs showed</span>
<span class="kw">const</span> { data, <span class="bad">isPending</span>, <span class="bad">error</span> } = <span class="fn">useQuery</span>({
  queryKey: [<span class="str">'todos'</span>],
  queryFn: () =&gt; <span class="fn">fetch</span>(<span class="str">'/api/todos'</span>).<span class="fn">then</span>(r =&gt; r.<span class="fn">json</span>()),
})

<span class="frag hiline"><span class="bad">if</span> (isPending) <span class="cm">// 🌀 Loading…</span>
<span class="bad">if</span> (error)     <span class="cm">// 💥 Oops!</span></span>

<span class="kw">return</span> &lt;<span class="fn">TodoList</span> items={data} /&gt;</pre>
          <div class="code-cap" style="max-width:20ch;">
            It's in <span class="hl">every application</span> you use.
            <div class="tax frag">
              <div><span class="tax-n">1</span> line renders your UI.</div>
              <div class="net"><span class="tax-n">6</span> lines negotiate with the network.</div>
            </div>
            <div class="taxnote frag">…and those six only exist because the data lives across the network.</div>
            <div class="punch frag">🤖 Nobody even types this anymore — the LLM writes it for you. It learned from the same docs.</div>
          </div>
        </div>
        <div class="pnum">5</div>
      </section>

      <!-- ========== 6 · EXTEND REACTIVITY TO THE SERVER ========== -->
      <section class="slide">
        <!-- NOTES: For a decade we optimized reactivity inside the client — view↔store. The gap now is the outer loop, store↔server. Local-first extends the same reactivity across the network. Same trick one layer down: like jQuery→React, imperative fetching→declarative data. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>Extend <span class="hl">reactivity</span> to the server</h2>
        <div class="diagram">
          <svg viewBox="0 0 960 350" preserveAspectRatio="xMidYMid meet">
            <defs>
              <marker id="a6g" markerWidth="11" markerHeight="11" refX="7" refY="5" orient="auto"><path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round"/></marker>
              <marker id="a6p" markerWidth="11" markerHeight="11" refX="7" refY="5" orient="auto"><path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--pen-purple)" stroke-width="2" stroke-linecap="round"/></marker>
            </defs>

            <!-- INNER LOOP · view ↔ store · tight + solid = always on -->
            <path d="M182 162 C 240 118 330 118 388 162" fill="none" stroke="var(--green)" stroke-width="2.8" marker-end="url(#a6g)"/>
            <path d="M388 190 C 330 234 240 234 182 190" fill="none" stroke="var(--green)" stroke-width="2.8" marker-end="url(#a6g)"/>
            <!-- OUTER LOOP · store ↔ server · wide + dashed = quiet background work -->
            <path d="M562 158 C 630 40 720 40 788 158" fill="none" stroke="var(--pen-purple)" stroke-width="2.4" stroke-dasharray="7 8" marker-end="url(#a6p)"/>
            <path d="M788 194 C 720 310 630 310 562 194" fill="none" stroke="var(--pen-purple)" stroke-width="2.4" stroke-dasharray="7 8" marker-end="url(#a6p)"/>

            <!-- node cards -->
            <g filter="url(#rough)">
              <rect x="40"  y="110" width="140" height="130" rx="18" fill="var(--card)" stroke="var(--line)" stroke-width="2.8"/>
              <rect x="390" y="110" width="170" height="130" rx="18" fill="var(--card)" stroke="var(--green)" stroke-width="3.2"/>
              <rect x="788" y="110" width="140" height="130" rx="18" fill="var(--card)" stroke="var(--line)" stroke-width="2.8"/>
            </g>

            <!-- ICON · view (browser window) -->
            <g filter="url(#rough)" transform="translate(110,168)">
              <rect x="-34" y="-26" width="68" height="52" rx="6" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.6"/>
              <path d="M-34 -13 H34" stroke="var(--line)" stroke-width="2.2"/>
              <circle cx="-27" cy="-20" r="2.3" fill="var(--line)"/><circle cx="-19" cy="-20" r="2.3" fill="var(--line)"/>
              <g stroke="var(--line)" stroke-width="2.4" stroke-linecap="round" opacity=".7"><path d="M-25 -3 H21 M-25 7 H11 M-25 17 H25"/></g>
            </g>

            <!-- ICON · store (local replica) -->
            <g filter="url(#rough)" transform="translate(475,168)">
              <g fill="#cfe0f7" stroke="var(--line)" stroke-width="2.6">
                <ellipse cx="0" cy="-20" rx="30" ry="9"/>
                <path d="M-30 -20 V17 A30 9 0 0 0 30 17 V-20"/>
              </g>
              <g fill="none" stroke="var(--line)" stroke-width="2.2" opacity=".75">
                <path d="M-30 -7 A30 9 0 0 0 30 -7"/><path d="M-30 5 A30 9 0 0 0 30 5"/>
              </g>
            </g>

            <!-- ICON · server (same cloud as slide 3) -->
            <g filter="url(#rough)" transform="translate(858,172) scale(.86)">
              <path d="M-42 14 q-26 -3 -27 -26 q3 -28 34 -26 q9 -26 42 -19 q26 -5 34 19 q26 0 22 28 q4 22 -22 23 z"
                    fill="#bfe3dd" stroke="var(--line)" stroke-width="3"/>
            </g>

            <!-- loop labels, held inside each lens -->
            <g class="hlabel" text-anchor="middle">
              <text x="285" y="170" font-size="23" fill="var(--green)">inner loop</text>
              <text x="285" y="194" font-size="18" fill="var(--pen-slate)">instant · local</text>
              <text x="675" y="170" font-size="23" fill="var(--pen-purple)">outer loop</text>
              <text x="675" y="194" font-size="18" fill="var(--pen-slate)">syncs quietly</text>
              <!-- node labels -->
              <text x="110" y="272" font-size="26" fill="var(--ink)">View</text>
              <text x="475" y="272" font-size="26" fill="var(--green)">Store</text>
              <text x="475" y="296" font-size="18" fill="var(--pen-slate)">live local replica</text>
              <text x="858" y="272" font-size="26" fill="var(--ink)">Server</text>
            </g>

            <!-- travelling arrows: the inner loop races, the outer one idles -->
            <g filter="url(#glow)">
              <path d="M-9 -7 L8 0 L-9 7 L-3 0 Z" fill="var(--green)" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/>
              <animateMotion dur="1.1s" repeatCount="indefinite" rotate="auto"
                path="M182 162 C 240 118 330 118 388 162 L388 190 C 330 234 240 234 182 190 Z"/>
            </g>
            <g filter="url(#glow)">
              <path d="M-9 -7 L8 0 L-9 7 L-3 0 Z" fill="var(--pen-purple)" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/>
              <animateMotion dur="6s" repeatCount="indefinite" rotate="auto"
                path="M562 158 C 630 40 720 40 788 158 L788 194 C 720 310 630 310 562 194 Z"/>
            </g>
          </svg>
        </div>
        <div class="cap">The same declarative shift React made for the DOM — now for <span class="hl-b">data loading</span>.</div>
        <div class="bigline">Why fetch when you can <span class="hl">sync</span>?</div>
        <div class="pnum">6</div>
      </section>

      <!-- ========== 7 · THE AFTER CODE ========== -->
      <section class="slide">
        <!-- NOTES: Same component after the shift. → this one live query IS the whole data layer. → count again: one line renders your UI, zero negotiate with the network. → six lines of ceremony gone, and the component barely changed — that's what makes it adoptable one component at a time. → and the LLM will write this one just as happily, once the docs it reads say so. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>The <span class="hl">after</span> code</h2>
        <div class="code-row">
<pre class="code"><span class="cm">// same component — you just stopped fetching</span>
<span class="frag hiline good"><span class="kw">const</span> { data } = <span class="fn">useLiveQuery</span>(q =&gt;
  q.<span class="fn">from</span>({ todos })
)</span>

<span class="kw">return</span> &lt;<span class="fn">TodoList</span> items={data} /&gt;

<span class="cm">// no fetch — the data is just there, locally</span>
<span class="cm">// the query stays live &amp; re-renders itself</span></pre>
          <div class="code-cap" style="max-width:20ch;">
            No fetch. No <span class="strike">isPending</span>. No <span class="strike">error</span>.
            <div class="tax frag">
              <div><span class="tax-n">1</span> line renders your UI.</div>
              <div class="ok"><span class="tax-n">0</span> lines negotiate with the network.</div>
            </div>
            <div class="taxnote frag">Six lines of ceremony, gone — and the component barely changed.</div>
            <div class="punch frag">🤖 The LLM will write this one just as happily. It only needs better docs.</div>
          </div>
        </div>
        <div class="pnum">7</div>
      </section>

      <!-- ========== 8 · RECORDED DEMO ========== -->
      <section class="slide">
        <!-- NOTES: Enough diagrams — here it is running. Recorded on purpose: the best moment of a talk should never depend on conference wifi. Linear-style tracker, ~500k rows. Watch four things: instant load, on-demand fetch while scrolling, instant filter re-paint, and a row you create that's there before the request leaves. Everything feels local because it is local. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>Enough talk — <span class="hl">half a million rows</span></h2>
        <div class="video">
          <div class="screen">
            <div class="mock-titlebar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="mtitle">Linear-style tracker — ~500,000 rows</span></div>
            <div class="scr-stage">
              <!-- ATTACH THE RECORDING HERE: replace the svg + .tag below with
                   <video src="demo.mp4" autoplay muted loop playsinline></video> -->
              <svg class="play-btn" viewBox="0 0 90 90">
                <g class="pulse"><g filter="url(#rough)">
                  <circle cx="45" cy="45" r="33" fill="rgba(191,227,221,.15)" stroke="#bfe3dd" stroke-width="3.4"/>
                  <path d="M37 27 L65 45 L37 63 Z" fill="#bfe3dd" stroke="#bfe3dd" stroke-width="2.4" stroke-linejoin="round"/>
                </g></g>
              </svg>
              <div class="tag">recorded on purpose — the best moment of a talk shouldn't depend on conference wifi</div>
            </div>
          </div>
          <div class="beats">
            <div class="beat"><span class="bn">1</span><div><b>Instant page load</b> — where this much data normally takes 10–20s.</div></div>
            <div class="beat"><span class="bn">2</span><div><b>Smooth infinite scroll</b> — the network panel fetches only the slice you're about to see.</div></div>
            <div class="beat"><span class="bn">3</span><div><b>Filter drills down instantly</b> — re-paints with no round-trip.</div></div>
            <div class="beat"><span class="bn">4</span><div><b>Create a row</b> — it's on screen before the request leaves, then syncs quietly.</div></div>
          </div>
        </div>
        <div class="cap">Everything feels local — <span class="hl-b">because it is local</span>.</div>
        <div class="pnum">8</div>
      </section>

      <!-- ========== 9 · THE WHOLE TRICK, IN THREE STEPS ========== -->
      <section class="slide">
        <!-- NOTES: You just watched the trick — here's the whole of it, and none of it is magic. Replicate the relevant slice into a live local store. Read locally — instant. Sync & merge — writes apply locally first, changes merge in. That's the whole pattern; every engine on the next slide implements exactly these three. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>The whole trick, in <span class="hl">three steps</span></h2>
        <div class="cards c3">
          <div class="card accent">
            <div class="chead">
              <span class="cnum">1</span>
              <svg class="cart" viewBox="0 0 68 46">
                <g filter="url(#rough)">
                  <g fill="#cfe0f7" stroke="var(--line)" stroke-width="2.2">
                    <ellipse cx="13" cy="13" rx="11" ry="4.5"/><path d="M2 13 V31 A11 4.5 0 0 0 24 31 V13"/>
                  </g>
                  <rect x="45" y="12" width="21" height="22" rx="3.5" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.2"/>
                  <path d="M45 19 H66" stroke="var(--line)" stroke-width="1.8"/>
                </g>
                <g fill="none" stroke="var(--pen-purple)" stroke-width="2.4" stroke-linecap="round">
                  <path d="M28 23 H40"/><path d="M36 19 L40 23 L36 27"/>
                </g>
              </svg>
            </div>
            <div class="ct">Replicate</div><div class="cd">The server mirrors the relevant slice of data into a live local store in the browser.</div>
          </div>
          <div class="card accent">
            <div class="chead">
              <span class="cnum">2</span>
              <svg class="cart" viewBox="0 0 68 46">
                <g filter="url(#rough)">
                  <rect x="3" y="10" width="36" height="27" rx="4" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.2"/>
                  <path d="M3 18 H39" stroke="var(--line)" stroke-width="1.8"/>
                  <g stroke="var(--line)" stroke-width="2" stroke-linecap="round" opacity=".45"><path d="M9 25 H32 M9 31 H26"/></g>
                  <path d="M53 5 L45 24 L52 24 L48 41 L63 20 L55 20 Z" fill="#ffd21a" stroke="var(--line)" stroke-width="2.2" stroke-linejoin="round"/>
                </g>
              </svg>
            </div>
            <div class="ct">Read locally</div><div class="cd">The UI reads from that local copy — no fetch, no spinner.</div>
          </div>
          <div class="card accent">
            <div class="chead">
              <span class="cnum">3</span>
              <svg class="cart" viewBox="0 0 68 46">
                <g filter="url(#rough)" transform="translate(34,23)" fill="none" stroke="var(--green)" stroke-width="3" stroke-linecap="round">
                  <path d="M-13 -4 A14 14 0 0 1 11 -9"/><path d="M11 -9 l-1 -8 M11 -9 l-8 2"/>
                  <path d="M13 4 A14 14 0 0 1 -11 9"/><path d="M-11 9 l1 8 M-11 9 l8 -2"/>
                </g>
              </svg>
            </div>
            <div class="ct">Sync &amp; merge</div><div class="cd">Writes apply optimistically and sync up; concurrent edits reconcile.</div>
          </div>
        </div>
        <div class="cap">Same three steps, <span class="hl-b">whatever the backend</span>.</div>
        <div class="pnum">9</div>
      </section>

      <!-- ========== 9b · WHOLE LOOP END TO END ========== -->
      <section class="slide">
        <!-- NOTES: The diagram runs frontend-first: your app is on the left, Postgres on the far right. Blue, moving right to left = a read: Postgres → sync engine → your proxy (auth+filter) → client store → UI. Red, moving left to right = a write: UI → store → your API → Postgres. Postgres hands back a txid that rides up the read path to retire the optimistic state. Every box is your stack. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>The whole loop, <span class="hl">end to end</span></h2>
        <div class="diagram">
          <!-- the viewBox is kept as short as the content allows (960x328): the svg scales to
               min(width/960, height/328), so squeezing the vertical padding is what lets the
               drawing fill the slide's full width instead of being letterboxed. -->
          <svg viewBox="0 0 960 328" preserveAspectRatio="xMidYMid meet">
            <defs>
              <!-- slim notched arrowheads, same silhouette as the travelling write glyph below.
                   userSpaceOnUse keeps them at a fixed size instead of being multiplied by stroke-width. -->
              <marker id="ahb" viewBox="0 0 12 8" markerUnits="userSpaceOnUse" markerWidth="24" markerHeight="16" refX="10.6" refY="4" orient="auto">
                <path d="M1.2 1 L11 4 L1.2 7 L3.3 4 Z" fill="var(--pen-blue)"/>
              </marker>
              <marker id="ahr" viewBox="0 0 12 8" markerUnits="userSpaceOnUse" markerWidth="24" markerHeight="16" refX="10.6" refY="4" orient="auto">
                <path d="M1.2 1 L11 4 L1.2 7 L3.3 4 Z" fill="var(--danger)"/>
              </marker>
            </defs>

            <!-- legend: the two paths, named and colour-coded, drawn exactly as they appear below -->
            <g>
              <rect x="308" y="4" width="344" height="38" rx="12" fill="#fdfaf1" stroke="#e4ddc7" stroke-width="1.6"/>
              <path d="M326 23 L372 23" fill="none" stroke="var(--pen-blue)" stroke-width="2.8" stroke-dasharray="10 8" marker-end="url(#ahb)"/>
              <text x="386" y="30" class="hlabel" font-size="19" fill="var(--pen-blue)">read path</text>
              <path d="M488 23 L534 23" fill="none" stroke="var(--danger)" stroke-width="2.8" marker-end="url(#ahr)"/>
              <text x="548" y="30" class="hlabel" font-size="19" fill="var(--danger)">write path</text>
            </g>

            <!-- ownership zones, front to back: what you ship, what you run, what you already own.
                 48 units of air between them so each reads as a separate place to deploy. -->
            <rect x="10"  y="72" width="322" height="228" rx="14" fill="#f8eef4" stroke="#eccbde" stroke-width="2"/>
            <rect x="380" y="72" width="182" height="228" rx="14" fill="#f3eef9" stroke="#dccbee" stroke-width="2"/>
            <rect x="610" y="72" width="340" height="228" rx="14" fill="#eef2fb" stroke="#c9d4ee" stroke-width="2"/>
            <g class="hlabel" font-size="18" text-anchor="middle" fill="var(--pen-slate)">
              <text x="171" y="64">Frontend</text><text x="471" y="64">Backend</text><text x="780" y="64">Your private infra</text>
            </g>

            <!-- READ path: one straight run right to left, Postgres → Sync engine → proxy → store → UI.
                 Marching ants carry the "continuous stream" reading without covering any label. -->
            <g fill="none" stroke="var(--pen-blue)" stroke-width="2.8" stroke-dasharray="10 8">
              <path d="M807 149 L773 149" marker-end="url(#ahb)"/>
              <path d="M617 149 L543 149" marker-end="url(#ahb)"/>
              <path d="M387 149 L325 149" marker-end="url(#ahb)"/>
              <path d="M169 149 L135 149" marker-end="url(#ahb)"/>
              <animate attributeName="stroke-dashoffset" from="18" to="0" dur="0.85s" repeatCount="indefinite"/>
            </g>
            <!-- WRITE path: UI → store (optimistic) → your API → Postgres, in the lane below -->
            <g fill="none" stroke="var(--danger)" stroke-width="2.8" stroke-linejoin="round">
              <path d="M76 190 L76 226 L243 226 L243 192" marker-end="url(#ahr)"/>
              <path d="M276 190 L276 260 L399 260" marker-end="url(#ahr)"/>
              <path d="M555 260 L875 260 L875 192" marker-end="url(#ahr)"/>
            </g>

            <g filter="url(#rough)">
              <rect x="20"  y="110" width="112" height="78" rx="12" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="172" y="110" width="150" height="78" rx="12" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="390" y="110" width="150" height="78" rx="12" fill="#e2d3f3" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="620" y="110" width="150" height="78" rx="12" fill="#cfe0f7" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="810" y="110" width="130" height="78" rx="12" fill="#bfe3dd" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="402" y="228" width="150" height="64" rx="12" fill="#e2d3f3" stroke="var(--line)" stroke-width="2.6"/>
            </g>
            <g style="font-family:var(--head)" font-weight="700" font-size="15" text-anchor="middle" fill="var(--ink)">
              <text x="76" y="155">Application</text>
              <text x="247" y="144">Client store</text><text x="247" y="165" font-size="11" font-weight="500">TanStack DB</text>
              <text x="465" y="144">Your proxy</text><text x="465" y="165" font-size="11" font-weight="500">Electric Proxy</text>
              <text x="695" y="144">Sync engine</text><text x="695" y="165" font-size="11" font-weight="500">ElectricSQL</text>
              <text x="875" y="155">Postgres</text>
              <text x="477" y="257">Custom API</text><text x="477" y="276" font-size="11" font-weight="500">your writes</text>
            </g>

            <!-- the boundary the whole talk is about -->
            <path d="M356 62 L356 310" fill="none" stroke="var(--pen-slate)" stroke-width="2.4" stroke-dasharray="6 7" opacity=".7"/>
            <text transform="translate(365,191) rotate(-90)" class="hlabel" font-size="16" fill="var(--pen-slate)" text-anchor="middle">the network</text>
            <text x="171" y="284" class="hlabel" font-size="19" fill="var(--green)" text-anchor="middle">everything here is local</text>

            <!-- the optimistic moment: the UI is already updated at the store -->
            <g filter="url(#rough)"><rect x="213" y="92" width="68" height="27" rx="13" fill="#d6f0e1" stroke="var(--green)" stroke-width="2.2"/></g>
            <text x="247" y="111" class="hlabel" font-size="18" fill="var(--green)" text-anchor="middle">0 ms</text>

            <text x="480" y="320" class="hlabel" font-size="17" fill="var(--pen-slate)" text-anchor="middle">the txid rides the read path home and retires the optimistic state</text>

            <!-- txid: one discrete green payload riding home above the read path,
                 stopping at the client store — that's where the optimistic state is retired. -->
            <g>
              <g filter="url(#rough)"><rect x="-23" y="-13" width="46" height="26" rx="13" fill="#d6f0e1" stroke="var(--green)" stroke-width="2.2"/></g>
              <text x="0" y="5" style="font-family:var(--mono)" font-size="12" font-weight="700" fill="var(--green)" text-anchor="middle">txid</text>
              <animateMotion dur="4.4s" repeatCount="indefinite" begin="1.2s" path="M875 103 L330 103"/>
            </g>
            <!-- the write is a single event, so it keeps a single travelling glyph -->
            <g filter="url(#glow)">
              <path d="M-9 -7 L8 0 L-9 7 L-3 0 Z" fill="var(--danger)" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/>
              <animateMotion dur="4.6s" repeatCount="indefinite" rotate="auto"
                path="M76 202 L76 226 L259 226 L259 260 L477 260 L875 260 L875 202"/>
            </g>
          </svg>
        </div>
        <div class="cap">Nothing at the edges gets rewritten — same Postgres, same components. Everything new sits in between, so you are <span class="hl-b">inserting a layer, not rewriting an application</span>.</div>
        <div class="pnum">9b</div>
      </section>

      <!-- ========== 9c · A READ, STEP BY STEP ========== -->
      <section class="slide">
        <!-- NOTES: The read loop in detail, and note there is only ever one store. 1 the component subscribes. 2 useLiveQuery registers the live query against the TanStack DB collection. 3 the collection answers immediately from local state. 4 if that shape isn't subscribed yet the collection opens a ShapeStream to your authorization proxy, 5 the proxy authenticates and forwards the authorized shape to the Electric sync engine, 6 Electric takes an initial snapshot and then follows Postgres logical replication, 7 snapshot then live changes stream back down through the proxy into the same collection, 8 the live query updates incrementally and the component re-renders. Steps 6 to 8 never stop — sync continues in the background for as long as the shape is subscribed. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>A read, <span class="hl">step by step</span></h2>
        <div class="diagram">
          <svg viewBox="0 0 960 372" preserveAspectRatio="xMidYMid meet">
            <defs>
              <!-- slim notched arrowheads, matching slide 9d/10: userSpaceOnUse keeps them a fixed
                   size instead of being multiplied by stroke-width. -->
              <marker id="a15" viewBox="0 0 12 8" markerUnits="userSpaceOnUse" markerWidth="24" markerHeight="16" refX="10.6" refY="4" orient="auto">
                <path d="M1.2 1 L11 4 L1.2 7 L3.3 4 Z" fill="var(--pen-blue)"/>
              </marker>
              <marker id="a15g" viewBox="0 0 12 8" markerUnits="userSpaceOnUse" markerWidth="24" markerHeight="16" refX="10.6" refY="4" orient="auto">
                <path d="M1.2 1 L11 4 L1.2 7 L3.3 4 Z" fill="var(--green)"/>
              </marker>
            </defs>

            <path d="M475 40 V352" fill="none" stroke="var(--pen-slate)" stroke-width="2.4" stroke-dasharray="6 7" opacity=".65"/>
            <text transform="translate(464,188) rotate(-90)" class="hlabel" font-size="16" fill="var(--pen-slate)" text-anchor="middle">the network</text>
            <text x="144" y="32" class="hlabel" font-size="18" fill="var(--green)" text-anchor="middle">in the browser</text>
            <text x="805" y="32" class="hlabel" font-size="18" fill="var(--pen-slate)" text-anchor="middle">your servers</text>

            <!-- one instance of every component: three in the browser, three on your servers -->
            <g filter="url(#rough)">
              <rect x="36"  y="46"  width="216" height="58" rx="13" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="36"  y="159" width="216" height="58" rx="13" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="36"  y="272" width="216" height="58" rx="13" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="700" y="272" width="210" height="58" rx="13" fill="#e2d3f3" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="700" y="159" width="210" height="58" rx="13" fill="#cfe0f7" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="700" y="46"  width="210" height="58" rx="13" fill="#bfe3dd" stroke="var(--line)" stroke-width="2.6"/>
            </g>
            <g style="font-family:var(--head)" font-weight="700" font-size="15" text-anchor="middle" fill="var(--ink)">
              <text x="144" y="71">React Component</text><text x="144" y="89" font-size="11" font-weight="500">renders the UI</text>
              <text x="144" y="184">useLiveQuery()</text><text x="144" y="202" font-size="11" font-weight="500">declares what it needs</text>
              <text x="144" y="297">TanStack DB Collection</text><text x="144" y="315" font-size="11" font-weight="500">local reactive data store</text>
              <text x="805" y="297">Authorization Proxy</text><text x="805" y="315" font-size="11" font-weight="500">auth + pins the WHERE</text>
              <text x="805" y="184">Electric Sync Engine</text><text x="805" y="202" font-size="11" font-weight="500">shape log over HTTP</text>
              <text x="805" y="71">Postgres</text><text x="805" y="89" font-size="11" font-weight="500">your existing database</text>
            </g>

            <!-- blue: subscription + sync traffic -->
            <g fill="none" stroke="var(--pen-blue)" stroke-width="2.8">
              <path d="M96 107 V155" marker-end="url(#a15)"/>
              <path d="M96 220 V268" marker-end="url(#a15)"/>
              <path d="M255 282 H694" marker-end="url(#a15)"/>
              <path d="M760 270 V220" marker-end="url(#a15)"/>
              <path d="M780 157 V106" marker-end="url(#a15)"/>
              <path d="M830 106 V157" marker-end="url(#a15)"/>
              <path d="M852 220 V268" marker-end="url(#a15)"/>
              <path d="M696 324 H257" marker-end="url(#a15)"/>
            </g>
            <!-- green: local results and incremental re-render, never leaves the browser -->
            <g fill="none" stroke="var(--green)" stroke-width="3.2">
              <path d="M204 268 V220" marker-end="url(#a15g)"/>
              <path d="M204 155 V107" marker-end="url(#a15g)"/>
            </g>

            <!-- the cross-network channel is the shape stream itself, not a component -->
            <g filter="url(#rough)"><rect x="342" y="290" width="266" height="26" rx="13" fill="#dce7fb" stroke="var(--pen-blue)" stroke-width="2.2"/></g>
            <text x="475" y="308" class="hlabel" font-size="15" fill="var(--pen-blue)" text-anchor="middle">ShapeStream: snapshot + live changes</text>

            <!-- one or two words per arrow, each sitting against the arrow it names -->
            <g class="hlabel" font-size="15">
              <g fill="var(--pen-blue)">
                <text x="106" y="136">subscribes</text>
                <text x="106" y="249">live query</text>
                <text x="768" y="136" text-anchor="end">logical replication</text>
                <text x="748" y="249" text-anchor="end">authorized shape</text>
                <text x="560" y="272" text-anchor="middle">subscribe shape</text>
                <text x="560" y="342" text-anchor="middle">live changes</text>
              </g>
              <g fill="var(--green)">
                <text x="214" y="136">re-renders</text>
                <text x="214" y="249">local result</text>
              </g>
            </g>

            <g filter="url(#glow)">
              <path d="M-9 -7 L8 0 L-9 7 L-3 0 Z" fill="var(--pen-blue)" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/>
              <animateMotion dur="7s" repeatCount="indefinite" rotate="auto"
                path="M258 282 H692 V324 H258 V282"/>
            </g>
          </svg>
        </div>
        <div class="cap">The UI always reads from the <span class="hl-b">local TanStack DB collection</span>. If the required data has not been synchronized, Electric loads the initial snapshot and continues streaming Postgres changes <span class="hl-b">in the background</span>.</div>
        <div class="pnum">9c</div>
      </section>

      <!-- ========== 9d · WHY LONG-POLLING, NOT WEBSOCKETS ========== -->
      <section class="slide">
        <!-- NOTES: The question everyone asks: why poll when WebSockets exist? Because a socket is an opaque stream — it has no URL, so nothing between you and the origin can help. Long-polling keeps the read path as ordinary cacheable GETs: one URL per shape, so browser cache, ETags, 304s and your CDN all keep working; stateless, so any server answers any poll and the load balancer you already run is enough; and each poll carries a log offset, so a reconnect just resumes instead of replaying. The honest trade is a little latency versus a socket push — which costs nothing here, because the UI already painted from the local store. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>Why long-polling, <span class="hl">not WebSockets</span></h2>
        <div class="race" style="margin:.5rem 0 0;">
          <div class="panel old">
            <div class="ph">WebSockets <span class="t">what you'd own</span></div>
            <div class="pb" style="align-items:flex-start;justify-content:center;min-height:clamp(120px,15vw,168px);gap:.5rem;">
              <!-- every client runs its own pipe all the way home; the cache can't participate -->
              <svg class="pdiag" viewBox="0 0 200 120">
                <g filter="url(#rough)" fill="#ffd9df" stroke="var(--danger)" stroke-width="2.2">
                  <rect x="4" y="14" width="26" height="18" rx="4"/><rect x="4" y="51" width="26" height="18" rx="4"/><rect x="4" y="88" width="26" height="18" rx="4"/>
                  <rect x="158" y="8" width="34" height="26" rx="5"/><rect x="158" y="49" width="34" height="26" rx="5"/><rect x="158" y="90" width="34" height="26" rx="5"/>
                </g>
                <g fill="none" stroke="var(--danger)" stroke-width="3.2" stroke-linecap="round">
                  <path d="M32 23 L156 21"/><path d="M32 60 L156 62"/><path d="M32 97 L156 103"/>
                </g>
              </svg>
              <div class="pl">An <b>opaque stream</b> — nothing in the middle can cache it.</div>
              <div class="pl"><b>Stateful:</b> every client pinned to one process.</div>
            </div>
          </div>
          <div class="panel new">
            <div class="ph">HTTP long-poll <span class="t">what you inherit</span></div>
            <div class="pb" style="align-items:flex-start;justify-content:center;min-height:clamp(120px,15vw,168px);gap:.5rem;">
              <!-- three clients, one origin read: the cache collapses them -->
              <svg class="pdiag" viewBox="0 0 200 120">
                <g filter="url(#rough)" fill="#d6f0e1" stroke="var(--green)" stroke-width="2.2">
                  <rect x="4" y="14" width="26" height="18" rx="4"/><rect x="4" y="51" width="26" height="18" rx="4"/><rect x="4" y="88" width="26" height="18" rx="4"/>
                  <rect x="164" y="44" width="32" height="32" rx="5"/>
                  <rect x="76" y="40" width="50" height="40" rx="6"/>
                </g>
                <text x="101" y="58" style="font-family:var(--mono)" font-size="13" font-weight="700" fill="var(--green)" text-anchor="middle">304</text>
                <path d="M92 66 L98 72 L110 60" fill="none" stroke="var(--green)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
                <g fill="none" stroke="var(--green)" stroke-width="2.4" stroke-linecap="round">
                  <path d="M32 23 L74 50"/><path d="M32 60 L74 60"/><path d="M32 97 L74 70"/>
                </g>
                <path d="M128 60 L162 60" fill="none" stroke="var(--green)" stroke-width="3.4" stroke-linecap="round"/>
              </svg>
              <div class="pl">One <b>URL per shape</b> — your CDN and <code>304</code>s just work.</div>
              <div class="pl"><b>Stateless:</b> any server answers any poll.</div>
            </div>
          </div>
        </div>
        <div class="bigline" style="font-size:clamp(1.1rem,2.4vw,1.7rem);">The boring protocol <span class="hl">is the feature</span>.</div>
        <div class="cap">The trade is a little latency against a socket push — which costs nothing, because <span class="hl-b">the UI already painted from the local store</span>.</div>
        <div class="pnum">9d</div>
      </section>

      <!-- ========== 10 · PARTIAL REPLICATION & FAN-OUT ========== -->
      <section class="slide">
        <!-- NOTES: You're not copying the whole DB into every browser. You declare a shape — a WHERE clause on the server — and only that subset syncs. Because the shape is declared once, every client entitled to it subscribes to the same stream: cached once, fanned out to many. That same WHERE clause is the authorization boundary we come back to later. A small live window, not the whole thing. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2><span class="hl">Partial replication</span> &amp; fan-out</h2>
        <div class="diagram">
          <svg viewBox="0 0 960 350" preserveAspectRatio="xMidYMid meet">
            <defs>
              <marker id="a10" markerWidth="11" markerHeight="11" refX="7" refY="5" orient="auto"><path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--line)" stroke-width="2" stroke-linecap="round"/></marker>
              <marker id="a10p" markerWidth="11" markerHeight="11" refX="7" refY="5" orient="auto"><path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--pen-purple)" stroke-width="2" stroke-linecap="round"/></marker>
            </defs>

            <!-- connectors -->
            <path d="M162 175 L338 175" fill="none" stroke="var(--line)" stroke-width="2.6" marker-end="url(#a10)"/>
            <path d="M560 175 C 645 175 692 107 764 107" fill="none" stroke="var(--pen-purple)" stroke-width="2.4" marker-end="url(#a10p)"/>
            <path d="M560 177 L764 179" fill="none" stroke="var(--pen-purple)" stroke-width="2.4" marker-end="url(#a10p)"/>
            <path d="M560 175 C 645 175 692 251 764 251" fill="none" stroke="var(--pen-purple)" stroke-width="2.4" marker-end="url(#a10p)"/>

            <!-- whole data model: deliberately the biggest object on the slide -->
            <g filter="url(#rough)" transform="translate(105,175)">
              <g fill="#cfe0f7" stroke="var(--line)" stroke-width="2.8">
                <ellipse cx="0" cy="-58" rx="52" ry="15"/>
                <path d="M-52 -58 V52 A52 15 0 0 0 52 52 V-58"/>
              </g>
              <g fill="none" stroke="var(--line)" stroke-width="2.2" opacity=".55">
                <path d="M-52 -36 A52 15 0 0 0 52 -36"/><path d="M-52 -14 A52 15 0 0 0 52 -14"/>
                <path d="M-52 8 A52 15 0 0 0 52 8"/><path d="M-52 30 A52 15 0 0 0 52 30"/>
              </g>
            </g>

            <!-- the shape: one declarative filter, the thing that actually does the work -->
            <g filter="url(#rough)">
              <rect x="345" y="136" width="213" height="78" rx="14" fill="#e2d3f3" stroke="var(--line)" stroke-width="2.8"/>
            </g>
            <text x="451" y="162" class="hlabel" font-size="19" fill="var(--pen-slate)" text-anchor="middle">one declarative shape</text>
            <text x="451" y="193" style="font-family:var(--mono)" font-size="17" font-weight="700" fill="var(--burgundy)" text-anchor="middle">WHERE org = 'acme'</text>

            <!-- clients: small live windows, all on the same stream -->
            <g filter="url(#rough)">
              <rect x="768" y="76"  width="134" height="62" rx="9" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="768" y="148" width="134" height="62" rx="9" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="768" y="220" width="134" height="62" rx="9" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.6"/>
              <g stroke="var(--line)" stroke-width="2.2"><path d="M768 95 H902 M768 167 H902 M768 239 H902"/></g>
              <g stroke="var(--line)" stroke-width="2.6" stroke-linecap="round" opacity=".5">
                <path d="M781 110 H872 M781 124 H850  M781 182 H872 M781 196 H850  M781 254 H872 M781 268 H850"/>
              </g>
            </g>

            <g class="hlabel" text-anchor="middle">
              <text x="105" y="268" font-size="24" fill="var(--ink)">Whole data model</text>
              <text x="105" y="292" font-size="18" fill="var(--danger)">you never ship this</text>
              <text x="250" y="163" font-size="18" fill="var(--pen-slate)">declare it once</text>
              <text x="655" y="166" font-size="19" fill="var(--pen-purple)">fan-out</text>
              <text x="835" y="308" font-size="24" fill="var(--ink)">Clients</text>
              <text x="835" y="332" font-size="18" fill="var(--pen-slate)">one shared stream, cached once</text>
            </g>

            <!-- records streaming through the shape and out to each client -->
            <g filter="url(#glow)">
              <path d="M-9 -7 L8 0 L-9 7 L-3 0 Z" fill="var(--pen-purple)" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/>
              <animateMotion dur="2.8s" repeatCount="indefinite" rotate="auto" begin="0s"
                path="M162 175 L345 175 L558 175 C 645 175 692 107 764 107"/>
            </g>
            <g filter="url(#glow)">
              <path d="M-9 -7 L8 0 L-9 7 L-3 0 Z" fill="var(--pen-purple)" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/>
              <animateMotion dur="2.8s" repeatCount="indefinite" rotate="auto" begin="0.95s"
                path="M162 175 L345 175 L558 177 L764 179"/>
            </g>
            <g filter="url(#glow)">
              <path d="M-9 -7 L8 0 L-9 7 L-3 0 Z" fill="var(--pen-purple)" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/>
              <animateMotion dur="2.8s" repeatCount="indefinite" rotate="auto" begin="1.9s"
                path="M162 175 L345 175 L558 175 C 645 175 692 251 764 251"/>
            </g>
          </svg>
        </div>
        <div class="cap">You don't ship the database — you declare a <b>shape</b>, and only that subset syncs. Declared once on the server, so every client entitled to it rides the <span class="hl-b">same cached stream</span>.</div>
        <div class="pnum">10</div>
      </section>

      <!-- ========== 10b · A WRITE, STEP BY STEP (BOTH PATHS) ========== -->
      <section class="slide">
        <!-- NOTES: Writes have two ways in. The default: call insert/update/delete on the collection — the store applies it optimistically, so the UI is correct at 0 ms, then posts to your API. The escape hatch: for complex multi-record work the UI calls your own endpoint directly and skips the store entirely. Both land in Postgres, and Postgres is the one source of truth — so both come home the same way, down the shape stream. On the default path the txid comes back with the row and the store retires the optimistic copy; if the server refuses, the optimistic copy is rolled back. The escape hatch needs no special support: it just syncs back like any other change. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>A write, <span class="hl">step by step</span></h2>
        <div class="diagram">
          <svg viewBox="0 0 960 372" preserveAspectRatio="xMidYMid meet">
            <defs>
              <marker id="a16g" markerWidth="11" markerHeight="11" refX="7" refY="5" orient="auto"><path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round"/></marker>
              <marker id="a16p" markerWidth="11" markerHeight="11" refX="7" refY="5" orient="auto"><path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--pen-purple)" stroke-width="2" stroke-linecap="round"/></marker>
            </defs>

            <!-- ===== lane 1 · the default: through the store, so there is a copy to reconcile ===== -->
            <text x="40" y="44" class="hlabel" font-size="21" fill="var(--green)">1 · the default</text>
            <g fill="none" stroke="var(--green)" stroke-width="2.8">
              <path d="M192 96 H226" marker-end="url(#a16g)"/>
              <path d="M382 96 H416" marker-end="url(#a16g)"/>
              <path d="M552 96 H586" marker-end="url(#a16g)"/>
              <path d="M655 128 V152 H305 V130" marker-end="url(#a16g)"/>
            </g>
            <g filter="url(#rough)">
              <rect x="40"  y="66" width="150" height="60" rx="12" fill="#d6f0e1" stroke="var(--green)" stroke-width="2.8"/>
              <rect x="230" y="66" width="150" height="60" rx="12" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="418" y="66" width="132" height="60" rx="12" fill="#e2d3f3" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="588" y="66" width="132" height="60" rx="12" fill="#bfe3dd" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="274" y="44" width="62" height="24" rx="12" fill="#d6f0e1" stroke="var(--green)" stroke-width="2.2"/>
            </g>
            <text x="305" y="61" class="hlabel" font-size="16" fill="var(--green)" text-anchor="middle">0 ms</text>
            <g style="font-family:var(--head)" font-weight="700" font-size="15" text-anchor="middle" fill="var(--ink)">
              <text x="115" y="92" style="font-family:var(--mono)" font-size="14">store.insert()</text>
              <text x="115" y="111" font-size="11" font-weight="500">through the store</text>
              <text x="305" y="92">Client store</text><text x="305" y="111" font-size="11" font-weight="500">applies it optimistically</text>
              <text x="484" y="92">Your API</text><text x="484" y="111" font-size="11" font-weight="500">one transaction</text>
              <text x="654" y="92">Postgres</text><text x="654" y="111" font-size="11" font-weight="500">the source of truth</text>
            </g>
            <text x="480" y="172" class="hlabel" font-size="18" fill="var(--green)" text-anchor="middle">the row comes back with a txid — the optimistic copy is retired, or rolled back</text>

            <path d="M30 206 H930" fill="none" stroke="#ddd5ae" stroke-width="2" stroke-dasharray="5 6"/>

            <!-- ===== lane 2 · the escape hatch: skips the store, so there is nothing to reconcile ===== -->
            <text x="40" y="248" class="hlabel" font-size="21" fill="var(--pen-purple)">2 · the escape hatch</text>
            <g fill="none" stroke="var(--pen-purple)" stroke-width="2.8">
              <path d="M192 300 H226" marker-end="url(#a16p)"/>
              <path d="M362 300 H396" marker-end="url(#a16p)"/>
              <path d="M532 300 H566" marker-end="url(#a16p)"/>
            </g>
            <g filter="url(#rough)">
              <rect x="40"  y="270" width="150" height="60" rx="12" fill="#e2d3f3" stroke="var(--pen-purple)" stroke-width="2.8"/>
              <rect x="230" y="270" width="132" height="60" rx="12" fill="#e2d3f3" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="398" y="270" width="132" height="60" rx="12" fill="#bfe3dd" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="568" y="270" width="160" height="60" rx="12" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.6"/>
            </g>
            <g style="font-family:var(--head)" font-weight="700" font-size="15" text-anchor="middle" fill="var(--ink)">
              <text x="115" y="294" style="font-family:var(--mono)" font-size="13">fetch('/reorder')</text>
              <text x="115" y="314" font-size="11" font-weight="500">complex, multi-record work</text>
              <text x="296" y="296">Your API</text><text x="296" y="315" font-size="11" font-weight="500">the same API as above</text>
              <text x="464" y="296">Postgres</text><text x="464" y="315" font-size="11" font-weight="500">the source of truth</text>
              <text x="648" y="296">Client store</text><text x="648" y="315" font-size="11" font-weight="500">the change just arrives</text>
            </g>
            <text x="549" y="258" class="hlabel" font-size="17" fill="var(--pen-purple)" text-anchor="middle">shape stream</text>
            <text x="800" y="352" class="hlabel" font-size="18" fill="var(--pen-purple)" text-anchor="end">no optimistic copy, so nothing to retire</text>

            <g filter="url(#glow)">
              <path d="M-9 -7 L8 0 L-9 7 L-3 0 Z" fill="var(--green)" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/>
              <animateMotion dur="6s" repeatCount="indefinite" rotate="auto" path="M115 96 H654 V152 H305 V96"/>
            </g>
            <g filter="url(#glow)">
              <path d="M-9 -7 L8 0 L-9 7 L-3 0 Z" fill="var(--pen-purple)" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/>
              <animateMotion dur="4.6s" begin="1s" repeatCount="indefinite" rotate="auto" path="M115 300 H648"/>
            </g>
          </svg>
        </div>
        <div class="cap">Two ways in, one source of truth — so both come home on the same stream. <span class="hl-b">The escape hatch needs no special support.</span></div>
        <div class="pnum">10b</div>
      </section>

      <!-- ========== 10c · INSIDE THE SYNC ENGINE ========== -->
      <section class="slide">
        <!-- NOTES: What the engine actually does. It taps Postgres logical replication — the WAL — so it never polls your tables. For each shape it keeps one append-only log of operations, numbered by offset. A client is nothing more than a cursor into that log: it asks for everything after the offset it already has. And here's the part that makes HTTP work: every segment behind the tip is immutable, because history doesn't change — so your CDN can cache it forever, and only the live tip is ever an uncached request. On the client, incremental view maintenance re-runs only the queries that touch a changed row, which is what keeps a live query sub-millisecond. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>Inside the <span class="hl">sync engine</span></h2>
        <div class="diagram">
          <svg viewBox="0 0 960 372" preserveAspectRatio="xMidYMid meet">
            <defs>
              <marker id="a17" markerWidth="11" markerHeight="11" refX="7" refY="5" orient="auto"><path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--line)" stroke-width="2" stroke-linecap="round"/></marker>
              <marker id="a17s" markerWidth="11" markerHeight="11" refX="7" refY="5" orient="auto"><path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--pen-slate)" stroke-width="2" stroke-linecap="round"/></marker>
            </defs>

            <rect x="248" y="70" width="596" height="156" rx="16" fill="#eef2fb" stroke="#c9d4ee" stroke-width="2"/>
            <text x="546" y="96" class="hlabel" font-size="20" fill="var(--pen-slate)" text-anchor="middle">one append-only log per shape</text>

            <path d="M142 140 H244" fill="none" stroke="var(--line)" stroke-width="2.8" marker-end="url(#a17)"/>

            <g filter="url(#rough)">
              <rect x="16" y="106" width="126" height="68" rx="13" fill="#bfe3dd" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="264" y="126" width="88" height="52" rx="7" fill="#cfe0f7" stroke="var(--line)" stroke-width="2.4"/>
              <rect x="358" y="126" width="88" height="52" rx="7" fill="#cfe0f7" stroke="var(--line)" stroke-width="2.4"/>
              <rect x="452" y="126" width="88" height="52" rx="7" fill="#cfe0f7" stroke="var(--line)" stroke-width="2.4"/>
              <rect x="546" y="126" width="88" height="52" rx="7" fill="#cfe0f7" stroke="var(--line)" stroke-width="2.4"/>
              <rect x="640" y="126" width="88" height="52" rx="7" fill="#cfe0f7" stroke="var(--line)" stroke-width="2.4"/>
              <rect x="734" y="126" width="88" height="52" rx="7" fill="#f6e3a6" stroke="#a8842a" stroke-width="3"/>
            </g>
            <g style="font-family:var(--mono)" font-weight="700" font-size="15" text-anchor="middle" fill="var(--pen-slate)">
              <text x="308" y="158">0</text><text x="402" y="158">1</text><text x="496" y="158">2</text>
              <text x="590" y="158">3</text><text x="684" y="158">4</text>
              <text x="778" y="158" fill="#7a5f12">5</text>
            </g>
            <g style="font-family:var(--head)" font-weight="700" font-size="15" text-anchor="middle" fill="var(--ink)">
              <text x="79" y="134">Postgres</text><text x="79" y="154" font-size="11" font-weight="500">logical replication</text>
            </g>

            <path d="M264 190 H728" fill="none" stroke="var(--pen-blue)" stroke-width="2.2"/>
            <path d="M264 190 V184 M728 190 V184" fill="none" stroke="var(--pen-blue)" stroke-width="2.2"/>
            <text x="496" y="210" class="hlabel" font-size="18" fill="var(--pen-blue)" text-anchor="middle">history never changes — cache it forever</text>
            <text x="778" y="118" class="hlabel" font-size="18" fill="#8a6a14" text-anchor="middle">the live tip</text>

            <!-- clients are cursors into that log -->
            <g stroke="var(--pen-slate)" stroke-width="2.4" stroke-dasharray="6 6" fill="none">
              <path d="M366 282 L400 184" marker-end="url(#a17s)"/>
              <path d="M536 282 L588 184" marker-end="url(#a17s)"/>
              <path d="M706 282 L772 184" marker-end="url(#a17s)"/>
            </g>
            <g filter="url(#rough)">
              <rect x="306" y="284" width="122" height="54" rx="11" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.4"/>
              <rect x="476" y="284" width="122" height="54" rx="11" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.4"/>
              <rect x="646" y="284" width="122" height="54" rx="11" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.4"/>
            </g>
            <g style="font-family:var(--head)" font-weight="700" font-size="14" text-anchor="middle" fill="var(--ink)">
              <text x="367" y="306">Client</text><text x="367" y="324" style="font-family:var(--mono)" font-size="11" font-weight="500">offset 1</text>
              <text x="537" y="306">Client</text><text x="537" y="324" style="font-family:var(--mono)" font-size="11" font-weight="500">offset 3</text>
              <text x="707" y="306">Client</text><text x="707" y="324" style="font-family:var(--mono)" font-size="11" font-weight="500">offset 5</text>
            </g>
            <text x="150" y="300" class="hlabel" font-size="20" fill="var(--green)" text-anchor="middle">a client is just</text>
            <text x="150" y="324" class="hlabel" font-size="20" fill="var(--green)" text-anchor="middle">a cursor</text>

            <g filter="url(#glow)">
              <circle r="6.5" fill="var(--pen-blue)" stroke="#fff" stroke-width="1.5"/>
              <animateMotion dur="4.4s" repeatCount="indefinite" path="M79 140 H244 L308 152 H778"/>
            </g>
          </svg>
        </div>
        <div class="cap">Everything behind the tip is immutable, so your CDN caches it forever. On the client, only the queries touching a changed row re-run — <span class="hl-b">that's what keeps a live query sub-millisecond</span>.</div>
        <div class="pnum">10c</div>
      </section>

      <!-- ========== 11 · THE ENGINES ========== -->
      <section class="slide">
        <!-- NOTES: Local-first isn't a new idea — Figma and Linear shipped it years ago. But they each had to build the sync engine themselves, which is why nobody else did it. That's the part that changed: the engine is now a dependency you install, fed by Postgres logical replication, with a ~20 KB client store. The point isn't the vendor list, it's that the hard part is no longer yours to build. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>The hard part is <span class="hl">off the shelf</span></h2>
        <div class="race" style="margin:.4rem 0 0;">
          <div class="panel old">
            <div class="ph">Until recently <span class="t">you built it</span></div>
            <div class="pb" style="align-items:flex-start;justify-content:center;min-height:clamp(104px,13vw,144px);gap:.5rem;">
              <!-- machinery you own and turn yourself, burning money as it grinds -->
              <svg class="picon" viewBox="0 0 92 60">
                <g style="font-family:var(--head)" font-weight="700" font-size="18" fill="var(--danger)" text-anchor="middle">
                  <text x="8" y="52">$
                    <animate attributeName="y" values="52;10" dur="2.6s" repeatCount="indefinite"/>
                    <animate attributeName="opacity" values="0;.95;.95;0" keyTimes="0;0.18;0.68;1" dur="2.6s" repeatCount="indefinite"/>
                  </text>
                  <text x="14" y="52">$
                    <animate attributeName="y" values="52;10" dur="3.1s" begin="0.9s" repeatCount="indefinite"/>
                    <animate attributeName="opacity" values="0;.95;.95;0" keyTimes="0;0.18;0.68;1" dur="3.1s" begin="0.9s" repeatCount="indefinite"/>
                  </text>
                  <text x="7" y="52">$
                    <animate attributeName="y" values="52;10" dur="2.8s" begin="1.8s" repeatCount="indefinite"/>
                    <animate attributeName="opacity" values="0;.95;.95;0" keyTimes="0;0.18;0.68;1" dur="2.8s" begin="1.8s" repeatCount="indefinite"/>
                  </text>
                </g>
                <g transform="translate(36,28)">
                  <g><animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="7s" repeatCount="indefinite"/>
                    <circle r="13" fill="#ffd9df" stroke="var(--danger)" stroke-width="2.4"/>
                    <g stroke="var(--danger)" stroke-width="2.8" stroke-linecap="round">
                      <path d="M13 0 H18 M9.2 9.2 L12.7 12.7 M0 13 V18 M-9.2 9.2 L-12.7 12.7 M-13 0 H-18 M-9.2 -9.2 L-12.7 -12.7 M0 -13 V-18 M9.2 -9.2 L12.7 -12.7"/>
                    </g>
                    <circle r="4.2" fill="none" stroke="var(--danger)" stroke-width="2"/>
                  </g>
                </g>
                <g transform="translate(66,20)">
                  <g><animateTransform attributeName="transform" type="rotate" from="360 0 0" to="0 0 0" dur="5.4s" repeatCount="indefinite"/>
                    <circle r="10" fill="#ffd9df" stroke="var(--danger)" stroke-width="2.2"/>
                    <g stroke="var(--danger)" stroke-width="2.6" stroke-linecap="round">
                      <path d="M10 0 H14 M7.1 7.1 L9.9 9.9 M0 10 V14 M-7.1 7.1 L-9.9 9.9 M-10 0 H-14 M-7.1 -7.1 L-9.9 -9.9 M0 -10 V-14 M7.1 -7.1 L9.9 -9.9"/>
                    </g>
                  </g>
                </g>
                <g transform="translate(72,44)">
                  <g><animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="4.2s" repeatCount="indefinite"/>
                    <circle r="8" fill="#ffd9df" stroke="var(--danger)" stroke-width="2.2"/>
                    <g stroke="var(--danger)" stroke-width="2.4" stroke-linecap="round">
                      <path d="M8 0 H11.5 M5.7 5.7 L8.1 8.1 M0 8 V11.5 M-5.7 5.7 L-8.1 8.1 M-8 0 H-11.5 M-5.7 -5.7 L-8.1 -8.1 M0 -8 V-11.5 M5.7 -5.7 L8.1 -8.1"/>
                    </g>
                  </g>
                </g>
              </svg>
              <div class="pl">Sync was <b>bespoke infrastructure</b> — change capture, reconciliation, live queries, all yours.</div>
              <div class="pl">Figma and Linear each spent <b>years and millions</b> building theirs.</div>
              <div class="pl">So local-first meant being a company that could afford that.</div>
            </div>
          </div>
          <div class="panel new">
            <div class="ph">Now <span class="t">you install it</span></div>
            <div class="pb" style="align-items:flex-start;justify-content:center;min-height:clamp(104px,13vw,144px);gap:.5rem;">
              <!-- a package you install: the tick lands, over and over -->
              <svg class="picon" viewBox="0 0 92 60">
                <g filter="url(#rough)" transform="translate(38,28)">
                  <path d="M-19 -8 L0 -17 L19 -8 L19 11 L0 20 L-19 11 Z" fill="#d6f0e1" stroke="var(--green)" stroke-width="2.4" stroke-linejoin="round"/>
                  <path d="M-19 -8 L0 1 L19 -8" fill="none" stroke="var(--green)" stroke-width="2"/>
                  <path d="M0 1 V20" fill="none" stroke="var(--green)" stroke-width="2"/>
                </g>
                <g>
                  <animate attributeName="opacity" values="0;0;1;1;1;0" keyTimes="0;0.22;0.34;0.9;0.96;1" dur="2.8s" repeatCount="indefinite"/>
                  <g filter="url(#rough)"><circle cx="66" cy="44" r="11.5" fill="#d6f0e1" stroke="var(--green)" stroke-width="2.4"/></g>
                  <path d="M60.5 44.5 L64.5 48.5 L72 40" fill="none" stroke="var(--green)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </g>
              </svg>
              <div class="pl">The sync engine is <b>a dependency</b>, open source and Postgres-native.</div>
              <div class="pl">Logical replication feeds it; the client store is <b>~20 KB</b>.</div>
              <div class="pl">So local-first is a library choice, not a roadmap.</div>
            </div>
          </div>
        </div>
        <div class="logorow">
          <div class="logogroup built">
            <div class="lg-t">they each built their own</div>
            <div class="logos">
              <span class="brandmark">
                <svg viewBox="0 0 24 36" aria-hidden="true">
                  <path d="M12 0 H6 A6 6 0 0 0 6 12 H12 Z" fill="#F24E1E"/>
                  <path d="M12 0 H18 A6 6 0 0 1 18 12 H12 Z" fill="#FF7262"/>
                  <path d="M12 12 H6 A6 6 0 0 0 6 24 H12 Z" fill="#A259FF"/>
                  <circle cx="18" cy="18" r="6" fill="#1ABCFE"/>
                  <path d="M12 24 H6 A6 6 0 0 0 6 36 H12 Z" fill="#0ACF83"/>
                </svg>Figma
              </span>
              <span class="brandmark">
                <svg viewBox="0 0 32 32" aria-hidden="true">
                  <rect x="1" y="1" width="30" height="30" rx="8" fill="#5E6AD2"/>
                  <g stroke="#fff" stroke-width="2.6" stroke-linecap="round">
                    <path d="M7 18 L19 6"/><path d="M8 25 L26 7"/><path d="M14 27 L27 14"/>
                  </g>
                </svg>Linear
              </span>
            </div>
          </div>
          <div class="logogroup shelf">
            <div class="lg-t">now you install one</div>
            <div class="enginestrip compact" style="margin:0;justify-content:flex-start;">
              <span>ElectricSQL</span><span>TanStack DB</span><span>Zero</span><span>PowerSync</span>
              <span class="more">+ 6 more</span>
            </div>
          </div>
        </div>
        <div class="cap" style="max-width:none;margin-top:.7rem;">The idea isn't new — what changed is that <span class="hl-b">you no longer have to build it</span>.</div>
        <div class="pnum">11</div>
      </section>

      <!-- ========== 12 · CONFLICTS SPECTRUM ========== -->
      <section class="slide">
        <!-- NOTES: The honest part — this isn't free. Conflicts: when two edits collide, who wins? Three stations, not two. Left: server-authoritative + rollback, effectively last-write-wins — fine for almost every internal application. Middle: merge per field, so two people editing different columns of a row both survive; cheap, no CRDT. Right: CRDTs, for two cursors inside one value — powerful and genuinely deep. The mistake is starting on the right. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>Where it earns its complexity: <span class="hl">conflicts</span></h2>
        <div class="spectrum">
          <svg class="specsvg" viewBox="0 0 960 132" preserveAspectRatio="xMidYMid meet">
            <defs>
              <linearGradient id="specg" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#1f8a5b"/><stop offset="0.5" stop-color="#d8b64a"/><stop offset="1" stop-color="#c62d42"/>
              </linearGradient>
            </defs>
            <g filter="url(#rough)">
              <rect x="40" y="70" width="880" height="26" rx="13" fill="url(#specg)" stroke="var(--line)" stroke-width="2.8"/>
              <circle cx="160" cy="83" r="13" fill="var(--card)" stroke="var(--line)" stroke-width="2.8"/>
              <circle cx="480" cy="83" r="13" fill="var(--card)" stroke="var(--line)" stroke-width="2.8"/>
              <circle cx="800" cy="83" r="13" fill="var(--card)" stroke="var(--line)" stroke-width="2.8"/>
            </g>
            <!-- "you are here": bobs over the cheap end -->
            <g>
              <animateTransform attributeName="transform" type="translate" values="0 0; 0 -7; 0 0" dur="2.4s" repeatCount="indefinite" calcMode="spline" keySplines="0.4 0 0.6 1;0.4 0 0.6 1"/>
              <text x="160" y="24" class="hlabel" font-size="23" fill="var(--green)" text-anchor="middle">almost everything lives here</text>
              <path d="M160 34 L160 58 M151 49 L160 59 L169 49" fill="none" stroke="var(--green)" stroke-width="3.4" stroke-linecap="round"/>
            </g>
            <text x="40"  y="122" class="hlabel" font-size="19" fill="var(--green)">cheap</text>
            <text x="920" y="122" class="hlabel" font-size="19" fill="var(--danger)" text-anchor="end">a rabbit hole</text>
          </svg>
          <div class="specrow">
            <div class="specstop">
              <div class="ss-t">Server-authoritative<br>+ rollback</div>
              <div class="ss-d">The default. Your optimistic change applies instantly; if the server rejects it, it rolls back. Effectively last-write-wins.</div>
            </div>
            <div class="specstop mid">
              <div class="ss-t">Merge per field</div>
              <div class="ss-d">Two people edit different columns of the same row and both survive. No CRDT — just stop overwriting whole rows.</div>
            </div>
            <div class="specstop hard">
              <div class="ss-t">CRDTs</div>
              <div class="ss-d">Two cursors inside one value — documents, canvases, presence. Powerful, and genuinely deep.</div>
              <div class="ss-ref">start with the Ink &amp; Switch paper</div>
            </div>
          </div>
        </div>
        <div class="bigline" style="font-size:clamp(1.1rem,2.4vw,1.7rem);">Start at the left. Move right <span class="hl">only when a user complains</span>.</div>
        <div class="pnum">12</div>
      </section>

      <!-- ========== 13 · DATA VOLUME: THREE SYNC MODES ========== -->
      <section class="slide">
        <!-- NOTES: You choose how much to sync. Eager: whole collection up front — fine for <10k mostly-static rows. On-demand: loads only what queries request — your component's query becomes the API call; pagination & infinite scroll for free. Progressive: instant first paint, then full set in the background. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>You choose <span class="hl">how much to sync</span></h2>
        <div class="cards c3">
          <div class="card accent">
            <div class="chead">
              <span class="cnum">1</span>
              <svg class="cart w" viewBox="0 0 96 48">
                <g filter="url(#rough)">
                  <g fill="none" stroke="var(--line)" stroke-width="1.8">
                    <rect x="4" y="4" width="28" height="5" rx="2"/><rect x="4" y="11" width="28" height="5" rx="2"/><rect x="4" y="18" width="28" height="5" rx="2"/>
                    <rect x="4" y="25" width="28" height="5" rx="2"/><rect x="4" y="32" width="28" height="5" rx="2"/><rect x="4" y="39" width="28" height="5" rx="2"/>
                  </g>
                  <g fill="none" stroke="var(--line)" stroke-width="1.8" opacity=".3">
                    <rect x="64" y="4" width="28" height="5" rx="2"/><rect x="64" y="11" width="28" height="5" rx="2"/><rect x="64" y="18" width="28" height="5" rx="2"/>
                    <rect x="64" y="25" width="28" height="5" rx="2"/><rect x="64" y="32" width="28" height="5" rx="2"/><rect x="64" y="39" width="28" height="5" rx="2"/>
                  </g>
                  <!-- the whole set lands in one go -->
                  <g fill="#cfe0f7" stroke="var(--line)" stroke-width="1.8">
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.13;0.9;1" dur="3.4s" repeatCount="indefinite"/>
                    <rect x="64" y="4" width="28" height="5" rx="2"/><rect x="64" y="11" width="28" height="5" rx="2"/><rect x="64" y="18" width="28" height="5" rx="2"/>
                    <rect x="64" y="25" width="28" height="5" rx="2"/><rect x="64" y="32" width="28" height="5" rx="2"/><rect x="64" y="39" width="28" height="5" rx="2"/>
                  </g>
                </g>
                <g fill="none" stroke="var(--mauve)" stroke-width="3.4" stroke-linecap="round">
                  <path d="M38 24 H56"/><path d="M50 19 L56 24 L50 29"/>
                </g>
              </svg>
            </div>
            <div class="ct">Eager</div>
            <div class="cd"><b>The default.</b> The whole collection arrives up front. Best under ~10k mostly-static rows — reference tables, settings.</div>
            <div class="cx">One wait at the start, then nothing ever again.</div>
          </div>
          <div class="card accent">
            <div class="chead">
              <span class="cnum">2</span>
              <svg class="cart w" viewBox="0 0 96 48">
                <g filter="url(#rough)">
                  <g fill="none" stroke="var(--line)" stroke-width="1.8">
                    <rect x="4" y="4" width="28" height="5" rx="2"/><rect x="4" y="11" width="28" height="5" rx="2"/><rect x="4" y="18" width="28" height="5" rx="2"/>
                    <rect x="4" y="25" width="28" height="5" rx="2"/><rect x="4" y="32" width="28" height="5" rx="2"/><rect x="4" y="39" width="28" height="5" rx="2"/>
                  </g>
                  <g fill="none" stroke="var(--line)" stroke-width="1.8" opacity=".3">
                    <rect x="64" y="4" width="28" height="5" rx="2"/><rect x="64" y="11" width="28" height="5" rx="2"/><rect x="64" y="18" width="28" height="5" rx="2"/>
                    <rect x="64" y="25" width="28" height="5" rx="2"/><rect x="64" y="32" width="28" height="5" rx="2"/><rect x="64" y="39" width="28" height="5" rx="2"/>
                  </g>
                  <!-- the window moves: a different query pulls a different slice -->
                  <g fill="#cfe0f7" stroke="var(--line)" stroke-width="1.8">
                    <animate attributeName="opacity" values="1;1;0;0" keyTimes="0;0.30;0.34;1" dur="4.2s" repeatCount="indefinite"/>
                    <rect x="64" y="18" width="28" height="5" rx="2"/><rect x="64" y="25" width="28" height="5" rx="2"/>
                  </g>
                  <g fill="#cfe0f7" stroke="var(--line)" stroke-width="1.8">
                    <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.30;0.34;0.63;0.67;1" dur="4.2s" repeatCount="indefinite"/>
                    <rect x="64" y="4" width="28" height="5" rx="2"/><rect x="64" y="11" width="28" height="5" rx="2"/>
                  </g>
                  <g fill="#cfe0f7" stroke="var(--line)" stroke-width="1.8">
                    <animate attributeName="opacity" values="0;0;1;1" keyTimes="0;0.63;0.67;1" dur="4.2s" repeatCount="indefinite"/>
                    <rect x="64" y="32" width="28" height="5" rx="2"/><rect x="64" y="39" width="28" height="5" rx="2"/>
                  </g>
                </g>
                <g fill="none" stroke="var(--mauve)" stroke-width="2" stroke-linecap="round">
                  <path d="M38 24 H56"/><path d="M51 20 L56 24 L51 28"/>
                </g>
              </svg>
            </div>
            <div class="ct">On-demand</div>
            <div class="cd">Only what your queries ask for. Best for large datasets, search and catalogs — <em>your query becomes the API call</em>.</div>
            <div class="cx">A brand-new query still waits — once.</div>
          </div>
          <div class="card accent">
            <div class="chead">
              <span class="cnum">3</span>
              <svg class="cart w" viewBox="0 0 96 48">
                <g filter="url(#rough)">
                  <g fill="none" stroke="var(--line)" stroke-width="1.8">
                    <rect x="4" y="4" width="28" height="5" rx="2"/><rect x="4" y="11" width="28" height="5" rx="2"/><rect x="4" y="18" width="28" height="5" rx="2"/>
                    <rect x="4" y="25" width="28" height="5" rx="2"/><rect x="4" y="32" width="28" height="5" rx="2"/><rect x="4" y="39" width="28" height="5" rx="2"/>
                  </g>
                  <g fill="#cfe0f7" stroke="var(--line)" stroke-width="1.8">
                    <rect x="64" y="18" width="28" height="5" rx="2"/><rect x="64" y="25" width="28" height="5" rx="2"/>
                  </g>
                  <!-- the rest keeps filling in behind the first paint -->
                  <g fill="#cfe0f7" stroke="var(--line)" stroke-width="1.8">
                    <animate attributeName="opacity" values="0;0;1;1;0" keyTimes="0;0.2;0.55;0.9;1" dur="3.2s" repeatCount="indefinite"/>
                    <rect x="64" y="4" width="28" height="5" rx="2"/><rect x="64" y="11" width="28" height="5" rx="2"/>
                    <rect x="64" y="32" width="28" height="5" rx="2"/><rect x="64" y="39" width="28" height="5" rx="2"/>
                  </g>
                </g>
                <g fill="none" stroke="var(--mauve)" stroke-width="2.6" stroke-linecap="round">
                  <path d="M38 19 H56"/><path d="M51 15 L56 19 L51 23"/>
                  <path d="M38 31 H56" stroke-dasharray="3 3.5"/><path d="M51 27 L56 31 L51 35"/>
                </g>
              </svg>
            </div>
            <div class="ct">Progressive</div>
            <div class="cd">The query subset paints instantly, then the full set syncs in behind it. Best for collaborative apps.</div>
            <div class="cx">Instant now, complete a moment later.</div>
          </div>
        </div>
        <div class="cap">Pagination and infinite scroll fall out of on-demand for free. So the <span class="hl-b">"but it loads the whole database!"</span> critique is really just the eager default — you dial this to the shape of your data, per collection.</div>
        <div class="pnum">13</div>
      </section>

      <!-- ========== 14 · AUTH: THE SERVER STILL DECIDES WHO SEES WHAT ========== -->
      <section class="slide">
        <!-- NOTES: The tradeoff that matters most at Amazon: authorization. This stack is non-prescriptive about auth. Put your own thin proxy in front. Authenticate with Midway/CloudAuth as you do today. Authorize by composing a WHERE clause on the shape — set on the server, never trusted from the client. That WHERE clause IS the authorization boundary. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>The server still decides <span class="hl">who sees what</span></h2>
        <div class="diagram">
          <svg viewBox="0 0 960 340" preserveAspectRatio="xMidYMid meet">
            <defs>
              <marker id="a14" markerWidth="11" markerHeight="11" refX="7" refY="5" orient="auto"><path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--pen-slate)" stroke-width="2" stroke-linecap="round"/></marker>
              <marker id="a14g" markerWidth="11" markerHeight="11" refX="7" refY="5" orient="auto"><path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round"/></marker>
            </defs>

            <!-- what the client asks for, and what actually leaves the proxy -->
            <g filter="url(#rough)">
              <rect x="120" y="56" width="180" height="34" rx="17" fill="var(--cream-2)" stroke="var(--pen-slate)" stroke-width="2.4"/>
              <rect x="420" y="56" width="300" height="34" rx="17" fill="#d6f0e1" stroke="var(--green)" stroke-width="2.6"/>
            </g>
            <text x="210" y="79" style="font-family:var(--mono)" font-size="15" font-weight="700" fill="var(--pen-slate)" text-anchor="middle">shape: issues</text>
            <text x="570" y="79" style="font-family:var(--mono)" font-size="15" font-weight="700" fill="var(--green)" text-anchor="middle">issues WHERE user_id = 42</text>
            <text x="570" y="108" class="hlabel" font-size="17" fill="var(--green)" text-anchor="middle">added on the server — never sent by the client</text>

            <!-- the one path in -->
            <path d="M174 170 L276 170" fill="none" stroke="var(--pen-slate)" stroke-width="2.8" marker-end="url(#a14)"/>
            <path d="M494 170 L586 170" fill="none" stroke="var(--green)" stroke-width="2.8" marker-end="url(#a14g)"/>
            <path d="M744 170 L806 170" fill="none" stroke="var(--green)" stroke-width="2.8" marker-end="url(#a14g)"/>

            <g filter="url(#rough)">
              <rect x="30"  y="130" width="144" height="80" rx="14" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="278" y="126" width="216" height="88" rx="14" fill="#e2d3f3" stroke="var(--pen-purple)" stroke-width="3.6"/>
              <rect x="586" y="130" width="158" height="80" rx="14" fill="#cfe0f7" stroke="var(--line)" stroke-width="2.6"/>
              <rect x="806" y="130" width="134" height="80" rx="14" fill="#bfe3dd" stroke="var(--line)" stroke-width="2.6"/>
            </g>

            <!-- padlock on the proxy: the only door -->
            <g filter="url(#rough)" transform="translate(386,152)">
              <rect x="-13" y="-2" width="26" height="20" rx="4" fill="var(--card)" stroke="var(--pen-purple)" stroke-width="2.6"/>
              <path d="M-7 -2 V-9 A7 7 0 0 1 7 -9 V-2" fill="none" stroke="var(--pen-purple)" stroke-width="2.6"/>
            </g>

            <g style="font-family:var(--head)" font-weight="700" font-size="16" text-anchor="middle" fill="var(--ink)">
              <text x="102" y="178">Client</text>
              <text x="386" y="196" fill="var(--pen-purple)">Your proxy</text>
              <text x="665" y="166">Sync engine</text><text x="665" y="187" font-size="11" font-weight="500">ElectricSQL</text>
              <text x="873" y="178">Postgres</text>
            </g>
            <g class="hlabel" font-size="17" fill="var(--pen-slate)" text-anchor="middle">
              <text x="386" y="238">authenticate — Midway / CloudAuth</text>
              <text x="386" y="259">authorize — compose the WHERE</text>
            </g>

            <!-- and no way around it -->
            <path d="M102 214 C 102 300 200 300 386 300 C 572 300 665 300 665 214"
                  fill="none" stroke="var(--danger)" stroke-width="2.4" stroke-dasharray="7 7" opacity=".85"/>
            <g stroke="var(--danger)" stroke-width="4.6" stroke-linecap="round">
              <path d="M374 288 L398 312 M398 288 L374 312"/>
            </g>
            <text x="700" y="306" class="hlabel" font-size="18" fill="var(--danger)">no path around it</text>

            <!-- a request relayed through the proxy: grey in, green out -->
            <g filter="url(#glow)">
              <path d="M-9 -7 L8 0 L-9 7 L-3 0 Z" fill="var(--pen-slate)" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/>
              <animateMotion dur="3.2s" repeatCount="indefinite" rotate="auto" path="M102 170 L276 170"/>
            </g>
            <g filter="url(#glow)">
              <path d="M-9 -7 L8 0 L-9 7 L-3 0 Z" fill="var(--green)" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/>
              <animateMotion dur="3.2s" begin="1.6s" repeatCount="indefinite" rotate="auto" path="M494 170 L873 170"/>
            </g>
          </svg>
        </div>
        <div class="bigline" style="font-size:clamp(1.1rem,2.4vw,1.7rem);">That <code>WHERE</code> clause <span class="hl">is</span> your authorization boundary.</div>
        <div class="cap">None of this is Electric-specific — you authenticate exactly as you do today, and the proxy is ordinary server code your reviewers already know how to read.</div>
        <div class="pnum">14</div>
      </section>

      <!-- ========== 15 · WHEN TO JUST FETCH ========== -->
      <section class="slide">
        <!-- NOTES: The most honest slide: plenty of screens should just fetch. Read-once data — reports, exports, a dashboard you open and close. Plain CRUD with no interactivity to speed up. Data that must not sit on the device at all. And authorization that isn't expressible as a filter — per-access audit, purpose-based access, field redaction. Rule of thumb: touched more than once, sync it; seen once and gone, fetch it. Local-first is a tool, not a religion. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>When to <span class="hl">just fetch</span></h2>
        <div class="cards c2 tight">
          <div class="card">
            <div class="chead">
              <span class="cnum">1</span>
              <svg class="cart" viewBox="0 0 68 46">
                <g filter="url(#rough)">
                  <rect x="10" y="6" width="30" height="34" rx="3" fill="#cfe0f7" stroke="var(--line)" stroke-width="2.2"/>
                  <g stroke="var(--line)" stroke-width="2" stroke-linecap="round" opacity=".45"><path d="M16 15 H34 M16 22 H34 M16 29 H28"/></g>
                  <rect x="42" y="24" width="24" height="17" rx="8.5" fill="var(--cream-2)" stroke="var(--pen-slate)" stroke-width="2.2"/>
                </g>
                <text x="54" y="36" style="font-family:var(--mono)" font-size="10" font-weight="700" fill="var(--pen-slate)" text-anchor="middle">1×</text>
              </svg>
            </div>
            <div class="ct">Read once, then closed</div>
            <div class="cd">Reports, exports, a dashboard you open and leave. No second read to make instant.</div>
          </div>
          <div class="card">
            <div class="chead">
              <span class="cnum">2</span>
              <svg class="cart" viewBox="0 0 68 46">
                <g filter="url(#rough)">
                  <rect x="5" y="9" width="37" height="28" rx="4" fill="#f2cfe2" stroke="var(--line)" stroke-width="2.2"/>
                  <g stroke="var(--line)" stroke-width="2" stroke-linecap="round" opacity=".45"><path d="M11 18 H33 M11 26 H27"/></g>
                  <path d="M48 31 L60 12 L65 15 L53 34 L46 36 Z" fill="#ffd21a" stroke="var(--line)" stroke-width="2.2" stroke-linejoin="round"/>
                </g>
              </svg>
            </div>
            <div class="ct">Plain CRUD</div>
            <div class="cd">A form, a save, a redirect. No interactivity for a local replica to speed up.</div>
          </div>
          <div class="card">
            <div class="chead">
              <span class="cnum">3</span>
              <svg class="cart" viewBox="0 0 68 46">
                <g filter="url(#rough)">
                  <rect x="6" y="8" width="33" height="25" rx="3" fill="var(--card)" stroke="var(--line)" stroke-width="2.2"/>
                  <path d="M2 38 H43" stroke="var(--line)" stroke-width="2.4" stroke-linecap="round"/>
                </g>
                <path d="M9 36 L38 6" stroke="var(--danger)" stroke-width="3.6" stroke-linecap="round"/>
                <g filter="url(#rough)" transform="translate(56,23)">
                  <rect x="-9" y="-2" width="18" height="14" rx="3" fill="#d6f0e1" stroke="var(--green)" stroke-width="2.2"/>
                  <path d="M-5 -2 V-7 A5 5 0 0 1 5 -7 V-2" fill="none" stroke="var(--green)" stroke-width="2.2"/>
                </g>
              </svg>
            </div>
            <div class="ct">Must not touch the device</div>
            <div class="cd">Regulated or sensitive enough you don't want it cached in a browser at all.</div>
          </div>
          <div class="card">
            <div class="chead">
              <span class="cnum">4</span>
              <svg class="cart" viewBox="0 0 68 46">
                <g filter="url(#rough)">
                  <path d="M10 8 H50 L35 26 V38 L25 33 V26 Z" fill="#cfe0f7" stroke="var(--line)" stroke-width="2.4" stroke-linejoin="round"/>
                </g>
                <path d="M12 40 L50 5" stroke="var(--danger)" stroke-width="3.6" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="ct">Rules a filter can't express</div>
            <div class="cd">Per-access audit, purpose-based access, field redaction — not a <code>WHERE</code> clause.</div>
          </div>
        </div>
        <div class="cap"><b>Rule of thumb:</b> touched more than once → <span class="hl-b">sync it</span>. Seen once and gone → <span class="hl-b">fetch it</span>.</div>
        <div class="bigline" style="font-size:clamp(1.1rem,2.4vw,1.7rem);">Local-first is a tool / architecture paradigm, <span class="hl">not a religion</span>.</div>
        <div class="pnum">15</div>
      </section>

      <!-- ========== 16 · PUT THE NETWORK BEHIND THE USER ========== -->
      <section class="slide">
        <!-- NOTES: Move the network behind the user and four things fall out at once — from one architectural move, not four bolted-on features. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <h2>Put the network <span class="hl">behind the user</span></h2>
        <div class="cards c4 tight">
          <div class="card">
            <div class="chead">
              <svg class="cart" viewBox="0 0 68 46">
                <g filter="url(#rough)">
                  <path d="M40 3 L20 26 L31 26 L26 43 L48 19 L36 19 Z" fill="#ffd21a" stroke="var(--line)" stroke-width="2.4" stroke-linejoin="round"/>
                </g>
                <g stroke="var(--mauve)" stroke-width="2.4" stroke-linecap="round"><path d="M54 10 l7 -5 M57 23 l8 -1 M53 35 l7 6"/></g>
              </svg>
            </div>
            <div class="ct">Instant reads</div><div class="cd">Straight from local memory.</div>
            <div class="cx">zero fetches in the component</div>
          </div>
          <div class="card">
            <div class="chead">
              <svg class="cart" viewBox="0 0 68 46">
                <g filter="url(#rough)">
                  <rect x="3" y="8"  width="38" height="8" rx="3" fill="var(--cream-2)" stroke="var(--line)" stroke-width="2"/>
                  <rect x="3" y="19" width="38" height="8" rx="3" fill="#d6f0e1" stroke="var(--green)" stroke-width="2.2"/>
                  <rect x="3" y="30" width="38" height="8" rx="3" fill="var(--cream-2)" stroke="var(--line)" stroke-width="2"/>
                  <circle cx="55" cy="23" r="10" fill="#d6f0e1" stroke="var(--green)" stroke-width="2.4"/>
                </g>
                <path d="M50 23 L54 27 L60 18" fill="none" stroke="var(--green)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="ct">Optimistic writes</div><div class="cd">No wait, no spinner.</div>
            <div class="cx">0 ms, then the txid tidies up</div>
          </div>
          <div class="card">
            <div class="chead">
              <svg class="cart" viewBox="0 0 68 46">
                <g fill="none" stroke="var(--line)" stroke-width="2.4" stroke-linecap="round">
                  <path d="M4 20 A20 20 0 0 1 36 20"/><path d="M9 27 A13 13 0 0 1 31 27"/><path d="M14 34 A6.5 6.5 0 0 1 26 34"/>
                  <circle cx="20" cy="39" r="1.8" fill="var(--line)"/>
                </g>
                <path d="M6 11 L35 40" stroke="var(--danger)" stroke-width="3.2" stroke-linecap="round"/>
                <g filter="url(#rough)"><circle cx="55" cy="21" r="10" fill="#d6f0e1" stroke="var(--green)" stroke-width="2.4"/></g>
                <path d="M50 21 L54 25 L60 16" fill="none" stroke="var(--green)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="ct">Works offline</div><div class="cd">Reconciles on reconnect.</div>
            <div class="cx">the same screen, minus the wifi</div>
          </div>
          <div class="card">
            <div class="chead">
              <svg class="cart" viewBox="0 0 68 46">
                <g filter="url(#rough)">
                  <rect x="4" y="5" width="60" height="36" rx="4" fill="var(--card)" stroke="var(--line)" stroke-width="2.2"/>
                </g>
                <g stroke="var(--line)" stroke-width="2.4" stroke-linecap="round" opacity=".5"><path d="M11 13 H46 M11 34 H40"/></g>
                <g stroke="var(--pen-slate)" stroke-width="2.4" stroke-linecap="round" opacity=".3"><path d="M11 20 H50 M11 27 H44"/></g>
                <g stroke="var(--danger)" stroke-width="2.6" stroke-linecap="round"><path d="M8 20 H53 M8 27 H47"/></g>
              </svg>
            </div>
            <div class="ct">Less glue code</div><div class="cd">No manual cache busting.</div>
            <div class="cx">six lines of ceremony, gone</div>
          </div>
        </div>
        <div class="cap">Not four features you bolt on — <span class="hl-b">four consequences of one architectural move</span>.</div>
        <div class="pnum">16</div>
      </section>

      <!-- ========== 17 · CLOSE ========== -->
      <section class="slide center-mid">
        <!-- NOTES: Don't rewrite anything. Pick one screen in one application — the worst spinner — and sync a local replica instead of fetching. Adopt one component at a time. The tools are here, open source, documented. Why fetch, when you can sync? Thank you. -->
        <div class="brand"><span class="logo-l">Local<b>·</b>First</span><span class="logo-r">WebDevCon '26</span></div>
        <div class="quote" style="max-width:26ch;">Stop building spinners.<br><b>Start syncing.</b></div>
        <ul class="bullets" style="margin-top:1.3rem;max-width:42ch;">
          <li>Pick the screen with your <b>worst spinner</b>.</li>
          <li>Sync a local replica instead of fetching it.</li>
          <li>Ship that one component — leave the rest alone.</li>
        </ul>
        <div class="cap" style="max-width:46ch;">The engines are open source and documented. <span class="hl-b">Nothing here needs a rewrite</span> — start Monday, not next quarter.</div>
        <div class="credit">"Why fetch when you can sync?" — after James Arthur, ElectricSQL (QCon SF 2025)</div>
        <div class="closeart">
          <svg viewBox="0 0 230 190">
            <g filter="url(#rough)">
              <rect x="12" y="24" width="150" height="112" rx="10" fill="var(--card)" stroke="var(--line)" stroke-width="3"/>
              <path d="M12 48 H162" stroke="var(--line)" stroke-width="2.4"/>
              <circle cx="26" cy="36" r="4" fill="#d9cfa0" stroke="var(--line)" stroke-width="1.8"/>
              <circle cx="40" cy="36" r="4" fill="#d9cfa0" stroke="var(--line)" stroke-width="1.8"/>
              <circle cx="54" cy="36" r="4" fill="#d9cfa0" stroke="var(--line)" stroke-width="1.8"/>
            </g>
            <g stroke="var(--line)" stroke-width="4" stroke-linecap="round" opacity=".32">
              <path d="M28 66 H140 M28 84 H120 M28 102 H132 M28 120 H108"/>
            </g>
            <g transform="translate(174,102)">
              <g><animateTransform attributeName="transform" type="scale" values="1;1.13;1" dur="2.4s" repeatCount="indefinite"/>
                <g filter="url(#glow)"><g filter="url(#rough)">
                  <path d="M13 -45 L-17 4 L4 4 L-11 47 L31 -11 L8 -11 Z" fill="#ffd21a" stroke="var(--line)" stroke-width="3.4" stroke-linejoin="round"/>
                </g></g>
              </g>
              <g stroke="var(--mauve)" stroke-width="3" stroke-linecap="round"><path d="M38 -32 l9 -9 M42 -6 l11 -2 M36 20 l9 9"/></g>
            </g>
            <text x="112" y="178" class="hlabel" font-size="21" fill="var(--pen-slate)" text-anchor="middle">start with your worst one</text>
          </svg>
        </div>
        <div class="presenters" style="bottom:8%;">
          <span style="display:block;font-family:var(--hand);font-weight:700;color:var(--pen-slate);font-size:.78em;">thank you</span>
          Ashish Singh &amp; Shivam Negi
        </div>
        <div class="pnum">17</div>
      </section>

      <div class="confidential">Amazon Confidential</div>
    </div>
  </div>
</div>

<svg width="0" height="0" style="position:absolute">
  <filter id="rough" x="-5%" y="-5%" width="110%" height="110%">
    <feTurbulence type="fractalNoise" baseFrequency="0.014" numOctaves="2" seed="7" result="n"/>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="4" xChannelSelector="R" yChannelSelector="G"/>
  </filter>
  <filter id="brush" x="-20%" y="-20%" width="140%" height="140%">
    <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="4" result="bn"/>
    <feDisplacementMap in="SourceGraphic" in2="bn" scale="9" xChannelSelector="R" yChannelSelector="G" result="disp"/>
    <feGaussianBlur in="disp" stdDeviation="1.4"/>
  </filter>
  <filter id="glow" x="-120%" y="-120%" width="340%" height="340%">
    <feGaussianBlur stdDeviation="5" result="b"/>
    <feMerge><feMergeNode in="b"/><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
  </filter>
</svg>

<div class="nav">
  <button id="prev">‹ Prev</button>
  <span class="counter"><span id="cur">1</span> / <span id="tot">0</span></span>
  <button id="next">Next ›</button>
  <button id="fs" title="Fullscreen (F)">⛶ Full</button>
  <span class="hint">F = fullscreen · N = notes · P = presenter</span>
</div>

<div id="presenter">
  <header>
    <span class="ptime" id="ptime" title="click to reset">00:00</span>
    <span class="ppos">slide <b id="ppos">1</b> / <span id="ptot">0</span></span>
    <div class="pdots" id="pdots"></div>
    <span class="pclicks" id="pclicks"></span>
    <div class="pbtns"><button id="pprev">‹ Prev</button><button id="pnext">Next ›</button></div>
  </header>
  <section class="pnow">
    <h3>Now</h3>
    <p id="pnownotes"></p>
  </section>
  <section class="pnext">
    <h3>Up next — slide <span id="pnextlabel"></span></h3>
    <div class="ptitle" id="pnexttitle"></div>
    <p id="pnextnotes"></p>
  </section>
  <div class="pfoot">Arrow keys / Space drive the audience window. Click the clock to reset it.</div>
</div>

<script>
  const slides = [...document.querySelectorAll('.slide')];
  let i = 0;
  const cur = document.getElementById('cur');
  document.getElementById('tot').textContent = slides.length;
  const fragsOf = idx => [...slides[idx].querySelectorAll('.frag')];

  // ---- slide-4 mock window, driven by fragment reveals ----
  const cursorPos = { idle:['8%','80%'], filter:['12%','16%'], search:['38%','16%'], edit:['30%','60%'] };
  function moveCursor(win, key){ const c=win.querySelector('.mock-cursor'); const p=cursorPos[key]||cursorPos.idle; c.style.left=p[0]; c.style.top=p[1]; }
  function playAct(win, act){
    if(!win) return;
    if(act==='empty'){ moveCursor(win,'edit'); win.classList.add('empty'); return; }
    moveCursor(win, act);
    const btn = act==='filter' ? win.querySelector('#mfilter') : act==='search' ? win.querySelector('#msearch') : null;
    const sp = win.querySelector('.mock-spinner');
    setTimeout(()=>{                                  // after the cursor glide
      if(btn){ btn.classList.add('click'); setTimeout(()=>btn.classList.remove('click'), 240); }
      sp.classList.add('on'); setTimeout(()=>sp.classList.remove('on'), act==='edit'?1300:1000);
    }, 600);
  }
  function resetWindow(win){
    if(!win) return;
    const slide = win.closest('.slide');
    const shown = [...slide.querySelectorAll('.callout.frag')].filter(f=>f.classList.contains('shown')).length;
    moveCursor(win, ['idle','filter','search','edit'][Math.min(shown,3)]);
    win.classList.toggle('empty', shown>=4);
    win.querySelector('.mock-spinner').classList.remove('on');
    win.querySelectorAll('.mbtn').forEach(b=>b.classList.remove('click'));
  }
  function onFrag(frag, forward){
    const act = frag.dataset.act; if(!act) return;
    const win = slides[i].querySelector('#mock4');
    if(forward) playAct(win, act); else resetWindow(win);
  }

  function setSlide(n, revealAll){
    i = Math.max(0, Math.min(slides.length-1, n));
    slides.forEach((s,x)=>s.classList.toggle('active', x===i));
    fragsOf(i).forEach(f=>f.classList.toggle('shown', !!revealAll));
    const w = slides[i].querySelector('#mock4'); if(w) resetWindow(w);
    cur.textContent = i+1;
    renderNotes();
    broadcastState();
    // presenter keeps its own URL, otherwise a reload would turn it into a second audience window
    if(!isPresenter) history.replaceState(null,'', '?s='+(i+1) + (notesOn ? '&notes=1' : ''));
  }

  // ---- presenter notes: pulled straight from each slide's <!-- NOTES: ... --> comment ----
  const notes = slides.map(s => {
    const c = [...s.childNodes].find(n => n.nodeType === Node.COMMENT_NODE && n.textContent.trim().startsWith('NOTES:'));
    return c ? c.textContent.trim().replace(/^NOTES:\s*/, '') : '';
  });
  const notesEl = document.createElement('div');
  notesEl.id = 'notes';
  document.body.appendChild(notesEl);
  let notesOn = new URLSearchParams(location.search).has('notes');
  function renderNotes(){
    notesEl.classList.toggle('on', notesOn);
    if(!notesOn) return;
    const f = [...slides[i].querySelectorAll('.frag')];
    const shown = f.filter(x=>x.classList.contains('shown')).length;
    const left = f.length - shown;
    notesEl.innerHTML =
      `<b>${slides[i].querySelector('.pnum')?.textContent || i+1}</b>` +
      (f.length ? `<span class="nfrag">${left>0 ? `${left} more click${left>1?'s':''} here` : 'next click advances'} (${shown}/${f.length})</span>` : '') +
      (notes[i] ? notes[i] : '<i>no notes on this slide</i>');
  }
  function next(){
    const hidden = fragsOf(i).find(f=>!f.classList.contains('shown'));
    if(hidden){ hidden.classList.add('shown'); onFrag(hidden, true); renderNotes(); broadcastState(); return; }
    if(i < slides.length-1) setSlide(i+1, false);
  }
  function prev(){
    const shown = fragsOf(i).reverse().find(f=>f.classList.contains('shown'));
    if(shown){ shown.classList.remove('shown'); onFrag(shown, false); renderNotes(); broadcastState(); return; }
    if(i > 0) setSlide(i-1, true);
  }
  document.getElementById('next').onclick = next;
  document.getElementById('prev').onclick = prev;

  // ---- fullscreen: the deck fills whatever it's given, edge to edge ----
  // the fill is a class, not a side effect of the Fullscreen API: it also covers the cases where the
  // API is refused (no user gesture) or bypassed (macOS green button / View ▸ Enter Full Screen).
  const nativeFs = () => !!(document.fullscreenElement || document.webkitFullscreenElement);
  let fsFill = false;
  function setFill(on){ fsFill = on; document.body.classList.toggle('fs', on); }
  function toggleFullscreen(){
    const on = !fsFill;
    setFill(on);                                  // fill immediately, whatever the browser decides
    if(on){
      const el = document.documentElement;
      Promise.resolve((el.requestFullscreen || el.webkitRequestFullscreen).call(el)).catch(()=>{});
    } else if(nativeFs()){
      (document.exitFullscreen || document.webkitExitFullscreen).call(document);
    }
  }
  // leaving fullscreen by Esc or the browser's own control returns the framed view
  function syncFullscreen(){ if(!nativeFs()) setFill(false); else setFill(true); }
  document.addEventListener('fullscreenchange', syncFullscreen);
  document.addEventListener('webkitfullscreenchange', syncFullscreen);
  document.getElementById('fs').onclick = toggleFullscreen;
  // double-click anywhere on the slide area, the way a video player behaves
  document.getElementById('deck').addEventListener('dblclick', toggleFullscreen);

  // ---- two-window sync: presenter sends nav, audience broadcasts state back ----
  const isPresenter = new URLSearchParams(location.search).has('presenter');
  const chan = ('BroadcastChannel' in window) ? new BroadcastChannel('localfirst-deck') : null;
  const labelOf = n => slides[n].querySelector('.pnum')?.textContent || (n+1);
  const titleOf = n => (slides[n].querySelector('h2, h1, .quote')?.textContent || '').trim();

  function fragCount(n){
    const f = [...slides[n].querySelectorAll('.frag')];
    return { shown: f.filter(x=>x.classList.contains('shown')).length, total: f.length };
  }
  function broadcastState(){ if(chan && !isPresenter) chan.postMessage({ type:'state', i, ...fragCount(i) }); }

  if(isPresenter){
    document.body.classList.add('presenter');
    document.getElementById('ptot').textContent = slides.length;
    const send = action => chan && chan.postMessage({ type:'nav', action });
    document.getElementById('pnext').onclick = () => send('next');
    document.getElementById('pprev').onclick = () => send('prev');

    let t0 = Date.now();
    const ptime = document.getElementById('ptime');
    ptime.onclick = () => { t0 = Date.now(); };
    setInterval(() => {
      const s = Math.floor((Date.now()-t0)/1000);
      ptime.textContent = String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
    }, 500);

    window.renderPresenter = (n, shown, total) => {
      if(total === undefined){ const f = fragCount(n); shown = f.shown; total = f.total; }
      document.getElementById('ppos').textContent = labelOf(n);
      document.getElementById('pnownotes').innerHTML = notes[n] || '<i>no notes on this slide</i>';
      const nx = n+1 < slides.length ? n+1 : null;
      document.getElementById('pnextlabel').textContent = nx===null ? '—' : labelOf(nx);
      document.getElementById('pnexttitle').textContent = nx===null ? 'End of deck' : titleOf(nx);
      document.getElementById('pnextnotes').innerHTML = nx===null ? '' : (notes[nx] || '<i>no notes</i>');

      // reveal progress — so you know whether the next click reveals or advances
      document.getElementById('pdots').innerHTML =
        total ? Array.from({length: total}, (_,k) => `<i class="${k < shown ? 'on' : ''}"></i>`).join('') : '';
      const left = total - shown, cl = document.getElementById('pclicks');
      if(left > 0){
        cl.className = 'pclicks more';
        cl.textContent = `${left} more click${left>1?'s':''} here`;
      } else {
        cl.className = 'pclicks last';
        cl.textContent = nx===null ? 'last slide' : `next click → slide ${labelOf(nx)}`;
      }
    };
    renderPresenter(0);
    if(chan) chan.postMessage({ type:'hello' });   // ask the audience window for current position
  }

  if(chan) chan.onmessage = ev => {
    const m = ev.data || {};
    if(isPresenter){
      if(m.type==='state') renderPresenter(m.i, m.shown, m.total);
    } else {
      if(m.type==='nav' && m.action==='next') next();
      if(m.type==='nav' && m.action==='prev') prev();
      if(m.type==='hello') broadcastState();
    }
  };

  const sp = new URLSearchParams(location.search).get('s');
  setSlide(sp ? parseInt(sp,10)-1 : 0, !!sp);   // deep-link shows fully; fresh start hides frags
  document.addEventListener('keydown', e=>{
    if(e.key==='f'||e.key==='F'){ e.preventDefault(); toggleFullscreen(); return; }
    if(isPresenter){   // presenter drives the audience window rather than itself
      if(e.key==='ArrowRight'||e.key===' '){ e.preventDefault(); chan && chan.postMessage({type:'nav',action:'next'}); }
      if(e.key==='ArrowLeft'){ e.preventDefault(); chan && chan.postMessage({type:'nav',action:'prev'}); }
      return;
    }
    if(e.key==='ArrowRight'||e.key===' '){ e.preventDefault(); next(); }
    if(e.key==='ArrowLeft'){ e.preventDefault(); prev(); }
    if(e.key==='Home') setSlide(0, false);
    if(e.key==='End') setSlide(slides.length-1, true);
    if(e.key==='n'||e.key==='N'){ notesOn=!notesOn; renderNotes(); history.replaceState(null,'', '?s='+(i+1)+(notesOn?'&notes=1':'')); }
    if(e.key==='p'||e.key==='P'){ window.open(location.pathname+'?presenter=1', 'lf-presenter', 'width=980,height=760'); }
  });
</script>
</body>
</html>
